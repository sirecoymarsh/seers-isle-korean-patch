/*** Chapter 5 — Rowan Childhood  ***/

"chap05_rowanchildhood01" = "화창한 봄 햇살이 잔잔한 호수 위에서 수천 갈래 빛으로 부서진다.";
"chap05_rowanchildhood02" = "내 뒤에는 삼촌과 숙모가 사는 작은 산골 마을이 있다.";
"chap05_rowanchildhood03" = "큰길을 따라 올라가 그들의 초가지붕 집으로 향한다.";
"chap05_rowanchildhood04" = "삼촌 앨리스터는 집 앞 그늘에 의자를 놓고 앉아 그물을 손질하고 있다.";
"chap05_rowanchildhood06" = "문틀에 모습을 드러낸 로완은 아직 어린아이다.";
"chap05_rowanchildhood07" = "늘 불안하게 뒤를 살펴야 했던 방랑의 세월이 아직 그 아이에게 흔적을 남기지 않았다.";
"chap05_rowanchildhood08" = "나는 몸을 굽혀 삼촌의 뺨에 입을 맞춘다.";
"chap05_rowanchildhood09" = "삼촌은 하던 일을 무릎 위에 내려놓고 아버지 같은 다정한 눈으로 나를 바라본다.";
"chap05_rowanchildhood10" = "삼촌과 숙모에게는 아이가 없었다. 내가 그 집에 오게 된 사연은 비극적이었지만, 두 사람은 언제나 나를 딸로 여겼다.";
"chap05_rowanchildhood11" = "숙모가 오늘 저녁 벨테인 전야제에 낼 블랙커런트 타르트를 만들고 있단다."; //Alistair
"chap05_rowanchildhood12" = "부엌일을 도와드릴 게 있는지 여쭤봤니?";
"chap05_rowanchildhood13" = "나는 수줍게 미소 지으며 발끝을 내려다본다.";
"chap05_rowanchildhood14" = "네, 여쭤봤어요.";
"chap05_rowanchildhood15" = "이렇게 좋은 날에 집 안에만 있지 말라고 하셨어요.";
"chap05_rowanchildhood16" = "그리고 개빈과 산딸기를 따러 가기로 약속했어요.";
"chap05_rowanchildhood17" = "앨리스터가 한쪽 눈썹을 치켜올린다.";
"chap05_rowanchildhood18" = "개빈?";
"chap05_rowanchildhood19" = "네, 아시잖아요. 루터의 아들이요.";
"chap05_rowanchildhood20" = "삼촌이 한숨을 쉰다.";
"chap05_rowanchildhood21" = "그 집안 아이와 어울리지 말라고 내가 천 번은 말했을 텐데…";
"chap05_rowanchildhood22" = "부족장 집안은 우리 같은 사람들과 혼인하지 않아.";
"chap05_rowanchildhood23" = "게다가 루터에게는 아들이 하나뿐이니, 이미 그 아이의 앞날을 정해 두었을 거다.";

"chap05_rowanchildhood24_choice01_option" = "불공평해."; //Prometheus
"chap05_rowanchildhood24_choice01_01" = "그토록 오랜 세월이 흘렀어도 이런 터무니없는 규칙을 생각하면 여전히 화가 난다.";
"chap05_rowanchildhood24_choice01_02" = "누구나 자기 운명은 스스로 선택할 수 있어야 한다. 적어도 누구와 함께할지는 말이다.";

"chap05_rowanchildhood24_choice02_option" = "오래가지 못할 걸 안다."; //Gaia
"chap05_rowanchildhood24_choice02_01" = "어리석음과 무지에 둘러싸인 대가를 오랫동안 치른 나는, 무슨 일이 있었더라도 그 관계가 오래가지 못했으리라는 걸 너무나 잘 안다.";
