"chap06_bivouacarlyn63" = "기운을 차리고 출발하자."; //Rowan
"chap06_bivouacarlyn64" = "남은 식량을 나누어 말없이 아침을 먹는다.";
"chap06_bivouacarlyn65" = "내가 불씨와 재를 흩어 놓는 동안 알린은 담요를 갠다.";
"chap06_bivouacarlyn66" = "알린은 남은 말린 과일을 조금 꺼내 천으로 감싼 뒤 입구 근처의 잘 보이는 곳에 둔다.";
"chap06_bivouacarlyn67" = "알린은 아직도 던컨이 어딘가에 살아 있기를 바라는 모양이다.";
"chap06_bivouacarlyn68" = "동굴 밖으로 나오자 살을 에는 추위가 덮쳐 온다.";
"chap06_bivouacarlyn69" = "나는 몸서리를 억누른다.";
"chap06_bivouacarlyn70" = "우리는 출발한다.";
"chap06_bivouacarlyn71" = "산의 창백한 햇빛이 무지갯빛으로 반짝이는 호수 수면에 비친다.";
"chap06_bivouacarlyn72" = "우리는 오랫동안 말없이 걷는다.";
"chap06_bivouacarlyn73" = "고원은 산봉우리들에 둘러싸여 바람을 피하고 있지만, 살아 있는 짐승은 하나도 없는 듯하다.";
"chap06_bivouacarlyn74" = "주위는 거의 완전한 침묵에 잠겨 있어, 신성한 장소를 더럽히러 온 침입자가 된 듯한 불쾌한 기분이 든다.";
"chap06_bivouacarlyn75" = "길은 거석에서 다음 거석으로 이어져 맞은편 물가에 닿고, 그곳에서 정상 쪽으로 갈라져 비탈을 따라 구불구불 올라간다.";
"chap06_bivouacarlyn76" = "알린이 숨을 고르려고 멈춘다.";
"chap06_bivouacarlyn77" = "알린은 정상을 매섭게 노려본다.";
"chap06_bivouacarlyn78" = "어젯밤 멀리서 간신히 보이던 산 위의 붉은 자국이 이제는 선명하고 또렷하다.";
"chap06_bivouacarlyn79" = "저 위에 있는 게 뭔지 알아?";
"chap06_bivouacarlyn80" = "정상에 보이는 저 붉은 부분?";
"chap06_bivouacarlyn81" = "불꽃나무야.";
"chap06_bivouacarlyn82" = "불꽃나무?";
"chap06_bivouacarlyn83" = "나는 동굴에서 본 환영을 더 선명하게 떠올리려고 시선을 내린다.";
"chap06_bivouacarlyn84" = "예언자들의 세계로 통하는 문이자 그들 마법의 근원이야.";
"chap06_bivouacarlyn85" = "마법의 근원이라고?";
"chap06_bivouacarlyn86" = "알린은 생각에 잠긴 표정이다.";
"chap06_bivouacarlyn87" = "그녀의 눈을 보니 무슨 생각을 하는지 훤히 읽힌다.";
"chap06_bivouacarlyn88" = "알린…";
"chap06_bivouacarlyn89" = "예언자들의 마법을 훔칠 수 있는지는 모르겠지만…";
"chap06_bivouacarlyn90" = "하지만… 나무가 그 근원이라며?";
"chap06_bivouacarlyn91" = "마법이 나무에 담겨 있다면 우리가 가져갈 수도 있겠지, 안 그래?";
"chap06_bivouacarlyn92" = "예언자들이 우리 생사를 좌우할 힘을 쥐고 있어서는 안 돼…";

"chap06_bivouacarlyn93_choice01_option" = "너무 위험해."; //Gaia
"chap06_bivouacarlyn93_choice01_01" = "나는 한숨을 내쉰다.";
"chap06_bivouacarlyn93_choice01_02" = "모르겠어, 알린…";
"chap06_bivouacarlyn93_choice01_03" = "나한테는 너무 위험해 보여.";
"chap06_bivouacarlyn93_choice01_04" = "알린의 의지는 확고해 보인다.";
"chap06_bivouacarlyn93_choice01_05" = "우리가 겪은 일을 생각하면 그게 정의야.";
"chap06_bivouacarlyn93_choice01_06" = "정의일까, 복수일까?"; //Rowan
"chap06_bivouacarlyn93_choice01_07" = "알린이 눈을 내리깐다.";

"chap06_bivouacarlyn93_choice01_07_arlynlove" = "그 일 때문에 네 목숨을 걸게 하고 싶지 않아, 알린.";
"chap06_bivouacarlyn93_choice01_08_arlynlove" = "나는…";
"chap06_bivouacarlyn93_choice01_09_arlynlove" = "알린이 갑자기 내 두 손을 자신의 손에 꼭 쥔다.";
"chap06_bivouacarlyn93_choice01_10_arlynlove" = "무슨 말인지 알아, 로완.";
"chap06_bivouacarlyn93_choice01_11_arlynlove" = "우리는 서로를 거의 모르는데도 아주 오래전부터 알고 지낸 것 같아.";
"chap06_bivouacarlyn93_choice01_12_arlynlove" = "내 시련을 끝내고, 예언자들을 설득해서 우리 둘 다 보내 달라고 할게.";
"chap06_bivouacarlyn93_choice01_13_arlynlove" = "나는 고개를 끄덕인다.";

"chap06_bivouacarlyn93_choice01_07_notarlynlove" = "네 가족을 생각해, 알린.";
"chap06_bivouacarlyn93_choice01_08_notarlynlove" = "그들을 위해서라도 살아남아야 해.";
"chap06_bivouacarlyn93_choice01_09_notarlynlove" = "가족에게는 네가 필요해.";
"chap06_bivouacarlyn93_choice01_10_notarlynlove" = "네 말이 맞아, 로완.";
"chap06_bivouacarlyn93_choice01_11_notarlynlove" = "우리 목표는 살아서 이 섬을 떠나는 거야.";
"chap06_bivouacarlyn93_choice01_12_notarlynlove" = "나는 고개를 끄덕인다.";

"chap06_bivouacarlyn93_choice02_option" = "시도해 볼 가치는 있어."; //Prometheus
"chap06_bivouacarlyn93_choice02_01" = "시도해 볼 가치는 있어.";
"chap06_bivouacarlyn93_choice02_02" = "예언자들이 우리에게 휘두르는 힘은 너무 커. 뭔가 바뀌어야 해…";
"chap06_bivouacarlyn93_choice02_03" = "알린은 결연한 표정이다.";
"chap06_bivouacarlyn93_choice02_04" = "그럼 우리가 해야 할 일은 정해졌네.";
"chap06_bivouacarlyn93_choice02_05" = "나는 고개를 끄덕인다.";

"chap06_bivouacarlyn94" = "우리는 다시 정상을 향해 출발한다.";
//-> Chap07 : The Summit



/*** Chapter 6 — Out of the caves — Order ***/
//Connor + Freya

"chap06_outofthecaves_order01" = "프레이야가 나를 빤히 바라본다.";
"chap06_outofthecaves_order02" = "프레이야는 망설이며 내 뿔을 향해 손을 뻗지만 감히 만지지는 못한다.";
"chap06_outofthecaves_order03" = "그런데… 넌 누구야?";
"chap06_outofthecaves_order04" = "곁눈질로 코너가 동굴의 어둠 속에서 나오는 모습이 보인다.";
"chap06_outofthecaves_order05" = "이름은 로완이야."; //Connor
"chap06_outofthecaves_order06" = "해변에서부터 우리를 지켜 줬어.";
"chap06_outofthecaves_order07" = "놀란 프레이야는 코너가 우리 곁으로 오는 모습을 바라본다.";
"chap06_outofthecaves_order08" = "그러고는 다시 나를 돌아본다.";

"chap06_outofthecaves_order09_freyakillederik" = "에릭…"; //Freya
"chap06_outofthecaves_order10_freyakillederik" = "내 손을 억지로 움직인 게 너였지?";
"chap06_outofthecaves_order11_freyakillederik" = "프레이야는 아무 표정 없이 나를 응시하며 내 설명을 기다린다.";
"chap06_outofthecaves_order12_freyakillederik" = "던컨은 무기를 내려놓았어…"; //Rowan
"chap06_outofthecaves_order13_freyakillederik" = "…그런데 넌 던컨을 구하려 하지 않았잖아.";

"chap06_outofthecaves_order09_duncankillederik" = "에릭… 던컨의 손을 움직인 것도 너였지?";
"chap06_outofthecaves_order10_duncankillederik" = "그래.";
"chap06_outofthecaves_order11_duncankillederik" = "달리 선택지가 없었어.";

"chap06_outofthecaves_order14" = "내가 끼어들지 않았다면 에릭은 던컨을 죽인 뒤 코너를 공격했을 테고, 결국 너도 에릭을 죽여야 했을 거야.";
"chap06_outofthecaves_order15" = "알겠어."; //Freya
"chap06_outofthecaves_order16" = "코너는 불안한 눈길을 동굴 쪽으로 거듭 보낸다.";
"chap06_outofthecaves_order17" = "던컨 얘기가 나와서 말인데, 혹시 봤어?";
"chap06_outofthecaves_order17A" = "아까 너를 찾으러 갔는데, 그 뒤로는…";
"chap06_outofthecaves_order18" = "나는 눈을 내리깐다.";
"chap06_outofthecaves_order19" = "알린은?";

"chap06_outofthecaves_order20_choice01_option" = "두 사람은 실패했어."; //Gaia
"chap06_outofthecaves_order20_choice01_01" = "안타깝지만 두 사람은 시련을 통과하지 못했어.";
"chap06_outofthecaves_order20_choice01_02" = "시련을 통과하지 못했다니? 그게 무슨 뜻이야?"; //Connor
"chap06_outofthecaves_order20_choice01_03" = "구하려고 했어… 하지만 너무 늦었어.";

"chap06_outofthecaves_order20_choice02_option" = "두 사람을 구하지 못했어."; //Prometheus
"chap06_outofthecaves_order20_choice02_01" = "두 사람을 구하지 못했어…";
"chap06_outofthecaves_order20_choice02_02" = "너무 늦었어.";
"chap06_outofthecaves_order20_choice02_03" = "예언자들이 데려갔어…";

"chap06_outofthecaves_order21" = "코너가 주먹을 꽉 쥔다.";
"chap06_outofthecaves_order22" = "프레이야는 잠시 참담한 표정을 짓지만 이내 마음을 다잡고 화제를 돌린다.";
"chap06_outofthecaves_order23" = "잘 모르겠어… 넌 예언자인 거야, 아닌 거야?"; //Freya
"chap06_outofthecaves_order24" = "아니… 정확히는 아니야.";
"chap06_outofthecaves_order25" = "전에는 너희처럼 인간이었어.";
"chap06_outofthecaves_order26" = "프레이야, 로완이 방금 알린과 던컨이 죽었다고 말한 거 알아?"; //Connor
"chap06_outofthecaves_order27" = "그래. 슬프고 괴로운 일이야.";
"chap06_outofthecaves_order28" = "그래도 정상까지는 아직 갈 길이 남았어.";
"chap06_outofthecaves_order29" = "이 섬을 떠나고 나면 슬퍼할 시간은 얼마든지 있어.";
"chap06_outofthecaves_order30" = "빌어먹을 예언자들…"; //Connor
"chap06_outofthecaves_order31" = "우리에게 너무 큰 힘을 휘두르고 있어!";
"chap06_outofthecaves_order32" = "만약 신전이 그들의 힘을 손에 넣는다면…";
"chap06_outofthecaves_order33" = "…재앙이 닥칠 거야.";
"chap06_outofthecaves_order34" = "신전은 여기서 무슨 일이 벌어지는지 전혀 몰라…"; //Freya
"chap06_outofthecaves_order35" = "알았다면 널 이 섬에 보내지 않았겠지.";
"chap06_outofthecaves_order36" = "장담하는데, 우리에게 일어나는 모든 일에는 분명 좋은 이유가 있어.";
"chap06_outofthecaves_order37" = "각 부족의 주술사들이 일어날 수 있는 일에 대비시켜 줬잖아.";
"chap06_outofthecaves_order38" = "내 말을 믿어, 코너. 예언자들은 믿어도 돼.";

"chap06_outofthecaves_order39_choice01_option" = "프레이야의 말에 동의한다."; //Gaia++
"chap06_outofthecaves_order39_choice01_01" = "프레이야 말이 맞아.";
"chap06_outofthecaves_order39_choice01_02" = "우리는 예언자들을 믿는 수밖에 없어.";
"chap06_outofthecaves_order39_choice01_03" = "정상에 도착하면 모든 일이 분명해질 거라고 확신해.";
"chap06_outofthecaves_order39_choice01_04" = "진심이야, 로완?";
"chap06_outofthecaves_order39_choice01_05" = "예언자들의 세계로 추방당하고도 정말 그들을 믿는다는 거야?";
"chap06_outofthecaves_order39_choice01_06" = "그러고 보니 어쩌다 이런 처지가 됐는지도 말하지 않았잖아.";
"chap06_outofthecaves_order39_choice01_07" = "대체 무슨 일을 했기에 예언자들의 세계에 갇힌 거야?";

"chap06_outofthecaves_order39_choice02_option" = "코너의 말에 동의한다."; //Prometheus++
"chap06_outofthecaves_order39_choice02_01" = "프레이야, 코너 말이 맞아.";
"chap06_outofthecaves_order39_choice02_02" = "예언자들이 이 모든 일을 겪게 했는데도 어떻게 계속 그들을 믿을 수 있어?";
"chap06_outofthecaves_order39_choice02_03" = "계속 믿음을 지켜야 해, 로완."; //Freya
"chap06_outofthecaves_order39_choice02_04" = "그러지 않으면 지금까지 내가 한 모든 일에 아무 의미가 없어져.";
"chap06_outofthecaves_order39_choice02_05" = "네가 예언자들에게 추방당했다면 그럴 만한 이유가 있다고 믿어야 하는 것처럼.";
"chap06_outofthecaves_order39_choice02_06" = "어쩌다 이런 처지가 된 거야, 로완?";

"chap06_outofthecaves_order40" = "모르겠어…";
"chap06_outofthecaves_order41" = "적어도 제대로 기억나지는 않아.";
"chap06_outofthecaves_order42" = "너희가 오기 전까지 영겁의 세월 동안 연옥에 있었어.";
"chap06_outofthecaves_order43" = "하지만 전에는 인간이었다고 했잖아…"; //Connor
"chap06_outofthecaves_order44" = "뭔가 기억나는 게 있을 것 아니야?";
"chap06_outofthecaves_order45" = "음… 나도 동굴에서 환영을 봤어."; //Rowan
"chap06_outofthecaves_order46_gaia" = "예언자들이 내 과거의 단편을 보여 줬어…";
"chap06_outofthecaves_order46_prometheus" = "내 과거의 단편을 엿봤어…";
"chap06_outofthecaves_order47" = "…그리고 미래도.";

"chap06_outofthecaves_order47_01" = "나도 동굴에서… 환영을 봤어…"; //Connor
"chap06_outofthecaves_order47_02" = "프레이야가 고개를 끄덕인다.";
"chap06_outofthecaves_order47_03" = "무엇을 보여 줬는데?"; //Freya
"chap06_outofthecaves_order47_04" = "내가 섬으로 보내진 순간. 내가… 마법을 썼다는 혐의를 받았을 때야.";
"chap06_outofthecaves_order47_05" = "코너는 믿을 수 없다는 표정을 짓는다.";
"chap06_outofthecaves_order47_06" = "마법이라고? 신전의 기준으로는 옛 종교를 따르는 사람은 모두 마법사야.";
"chap06_outofthecaves_order47_07" = "프레이야는 짜증스러운 눈길로 코너를 흘겨본 뒤 나를 돌아본다.";
"chap06_outofthecaves_order47_08" = "예언자들에게서 비롯되지 않은 “마법”을 다룬 전설이 있어…";
"chap06_outofthecaves_order47_09" = "그런 마법을 말하는 거야, 로완?";
"chap06_outofthecaves_order47_10" = "나는 한숨을 내쉰다.";
"chap06_outofthecaves_order47_11" = "모르겠어…";
"chap06_outofthecaves_order47_12" = "그러니까, 확신할 수 없어.";
"chap06_outofthecaves_order47_13" = "하지만… 그럴 리 없어."; //Connor
"chap06_outofthecaves_order47_14" = "그렇다면 로완이 처한 상황도 설명돼."; //Freya
"chap06_outofthecaves_order47_15" = "그런 마법은 오래전에 잊혔다고 해… 아주 오래된 전설 몇 편에만 나오지.";
"chap06_outofthecaves_order47_16" = "사윈 철야제에서 아이들을 겁주려고 들려주는 이야기야…";
"chap06_outofthecaves_order47_17" = "그렇다면 “마법사”가 근원과 이렇게 가까운 섬에 있다는 건…";
"chap06_outofthecaves_order47_18" = "코너는 불안해 보인다.";

"chap06_outofthecaves_order48" = "산꼭대기에 무엇이 있는지 알아?"; //Connor
"chap06_outofthecaves_order49" = "정확히는 몰라. 몇몇 짧은 순간만 봤어…";
"chap06_outofthecaves_order50" = "…하지만 너희와 함께 그곳에 가야 한다는 건 확실해.";
"chap06_outofthecaves_order51" = "프레이야는 깊은 생각에 잠긴 듯하다.";
"chap06_outofthecaves_order52" = "잘 이해가 안 돼."; //Freya
"chap06_outofthecaves_order53" = "네 존재가 원래 흘러가야 할 일을 어지럽히는 모양이야.";
"chap06_outofthecaves_order54" = "여기서 얼마나 오래 있었어?";

"chap06_outofthecaves_order54A" = "전혀 모르겠어…";
"chap06_outofthecaves_order54B" = "영겁의 세월 동안 이 섬에 있었던 듯하지만, 너희와 같은 때 도착했다고 해도 이상하지 않을 정도야.";
"chap06_outofthecaves_order54C" = "어쨌든 내 환영이 보여 준 건 그런 것 같아…";
