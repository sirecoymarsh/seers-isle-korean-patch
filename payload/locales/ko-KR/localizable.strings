/*** Chapter 6 — Bivouac Arlyn — Prometheus / Chaos ***/

"chap06_bivouacarlyn01" = "우리는 말없이 다시 출발한다.";
"chap06_bivouacarlyn02" = "곧 호숫가에 도착해 거석을 따라 호수를 끼고 걷는다.";
"chap06_bivouacarlyn03" = "알린은 하루 종일 걷고 격한 감정까지 겪은 탓에 몹시 지쳐 보인다.";

"chap06_bivouacarlyn04_rowandidntakethebag" = "나는 다시 가방을 들어 주겠다고 하고, 이번에는 알린도 고맙게 받아들인다.";

"chap06_bivouacarlyn05" = "나는 점점 더 불안해진다.";
"chap06_bivouacarlyn06" = "던컨의 흔적은 보이지 않고, 곧 쉴 곳을 찾지 못하면 어둠 속에서 눈 덮인 땅에 불을 피워야 한다.";
"chap06_bivouacarlyn07" = "로완?";
"chap06_bivouacarlyn08" = "알린이 조금 더 앞쪽, 길 왼편 바위에 난 틈을 가리킨다."; 
"chap06_bivouacarlyn09" = "응, 저건…"; //Rowan
"chap06_bivouacarlyn10" = "…동굴 같은데, 그렇지?"; //Arlyn
"chap06_bivouacarlyn11" = "가서 살펴볼게. 혹시 모르잖아.";
"chap06_bivouacarlyn12" = "기운을 되찾은 알린은 바위틈까지 남은 몇 걸음을 단숨에 건넌다.";
"chap06_bivouacarlyn13" = "알린은 몇 초 동안 어둠 속으로 사라졌다가 다시 나타나 내게 오라고 손짓한다.";
"chap06_bivouacarlyn14" = "동굴이야. 마른 장작까지 쌓여 있어."; //Arlyn
"chap06_bivouacarlyn15" = "마른 장작 더미라고? 그렇다면 이 동굴을 쓰는 건… 예언자들인가?";
"chap06_bivouacarlyn16" = "알린이 얼굴을 찌푸린다.";
"chap06_bivouacarlyn17" = "그래, 기습을 당할 위험은 있겠지만 달리 선택지가 있어?";
"chap06_bivouacarlyn18" = "나는 어깨를 으쓱한다.";
"chap06_bivouacarlyn19" = "아니, 네 말이 맞아. 감수할 수밖에 없는 위험이야.";
"chap06_bivouacarlyn20" = "알린은 화덕을 만들고 부싯돌로 불을 붙인다.";
"chap06_bivouacarlyn21" = "불빛이 밝아지자 벽면에 서로 얽힌 곡선과 고대의 기호가 새겨져 있는 것이 보인다. 그 의미는 영원히 시간 속에 묻혔다.";
"chap06_bivouacarlyn22" = "거석을 세운 장인들의 피난처였던 모양이다.";
"chap06_bivouacarlyn23" = "천장에는 연기가 빠져나갈 구멍까지 있다.";
"chap06_bivouacarlyn24" = "장작 근처 피난처 한구석에서 따뜻한 옷가지와 담요가 쌓인 더미를 발견한다.";
"chap06_bivouacarlyn25" = "알린에게 줄 것과 내 것을 하나씩 챙겨 그녀 곁에 앉는다.";
"chap06_bivouacarlyn26" = "알린은 남은 식량을 확인하고 있다.";
"chap06_bivouacarlyn27" = "다행히 둘이 먹고도 넉넉할 만큼 남았다.";
"chap06_bivouacarlyn28" = "알린이 껍질을 깐 견과류 한 줌을 내민다.";
"chap06_bivouacarlyn29" = "배고파?";
"chap06_bivouacarlyn30" = "놀랍게도 몹시 허기진 상태라는 걸 깨닫는다.";
"chap06_bivouacarlyn31" = "하나를 입에 넣고 깨무는 순간, 잊고 있던 감각이 입안 가득 되살아난다.";
"chap06_bivouacarlyn32" = "견과류를 처음 먹어 보는 사람 같네…"; //Arlyn
"chap06_bivouacarlyn33" = "느끼고, 맛보고, 만지는 감각을 되찾았다는 기쁨에 휩싸여 웃음을 터뜨린다…";
"chap06_bivouacarlyn34" = "오랫동안 배고픔도 갈증도 느끼지 못했으니 이게 얼마나 좋은지 모를 거야.";

//if Arlyn love
"chap06_bivouacarlyn35_arlynlove" = "알린이 짓궂은 눈으로 나를 바라본다.";
"chap06_bivouacarlyn36_arlynlove" = "견과류 하나만으로도 그런 반응이라면…";
"chap06_bivouacarlyn37_arlynlove" = "알린은 다정하게 내 머리카락을 쓸어 내리다가 갑자기 목덜미 쪽을 움켜쥐고 자신에게로 끌어당긴다.";
"chap06_bivouacarlyn38_arlynlove" = "나는 기꺼이 그녀에게 이끌려 간다.";
"chap06_bivouacarlyn39_arlynlove" = "우리는 길게 입을 맞춘다…";
"chap06_bivouacarlyn40_arlynlove" = "…그리고 몇 번이고 다시 입을 맞춘다."; //Cut fade to black
"chap06_bivouacarlyn41_arlynlove" = "얼마 뒤, 알린은 피리를 꺼내 나를 위해 연주한다.";
"chap06_bivouacarlyn42_arlynlove" = "그녀의 무릎을 베고 누워 애잔하고 쓸쓸한 선율에 몸을 맡긴다.";
"chap06_bivouacarlyn43_arlynlove" = "나도 모르는 사이 꿈도 없는 잠에 빠진다.";

