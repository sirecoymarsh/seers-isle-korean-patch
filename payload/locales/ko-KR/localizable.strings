/*** Chapter 2 — Seer or Cairn / POV: Duncan ***/

"chap02_seerorcairn01" = "대열 맨 앞에서 던컨은 멀리 보이는 숲을 바라보며 빠른 걸음을 유지하려 한다.";
"chap02_seerorcairn02" = "어느 길로 가야 할지 알려 주는 제대로 된 길은 없지만, 황야에는 길을 표시하듯 거석들이 흩어져 있다.";
"chap02_seerorcairn03" = "확실하지는 않지만, 삼촌 리스가 루나사드 축제의 어느 저녁에 무심코 이 길을 언급했던 것 같다. 당시 던컨은 술에 취한 삼촌을 틈타 섬에 관해 캐물었다.";
"chap02_seerorcairn04" = "길은 선돌과 선돌 사이를 굽이쳐 이어진다.";
"chap02_seerorcairn05" = "자신의 짐작이 맞든 아니든, 어쩌면 보이지 않는 위험으로부터 일행을 지켜 줄 이 표지들을 믿는 편이 숲으로 곧장 향하는 것보다 훨씬 현명해 보인다.";
"chap02_seerorcairn06" = "사람들이 기억하는 한 이 섬은 늘 황량하고 무인도였다. 마법의 입문 의식을 마치기 위해 예언자들의 승인을 구하러 온 수련자들의 원정대만 이따금 이곳을 찾았다.";
"chap02_seerorcairn07" = "던컨은 전통에 따라 거석 하나를 왼쪽으로 돌아 지나간다.";

"chap02_seerorcairn08" = "눈을 가늘게 뜨고 보니, 바람과 비에 반쯤 지워진 곡선 무늬가 서로 얽혀 있는 것이 보인다.";
"chap02_seerorcairn09" = "던컨은 이 조각들이 어떤 이야기를 전하거나, 적어도 이 건조물을 만든 자들에 관해 더 많은 것을 알려 주리라 생각한다.";
"chap02_seerorcairn10" = "전설 속 예언자들은 건축을 하지 않으며, 인간의 세계에 기념물을 세울 능력이나 의지가 있다는 이야기는 더더욱 없다…";
"chap02_seerorcairn11" = "가능한 설명은 먼 옛날 이 섬에 상당히 많은 사람이 상주했다는 것뿐이다. 이 거대한 건조물의 규모를 생각하면…";
"chap02_seerorcairn12" = "에릭과 프레이야가 발견한 절벽의 계단도 있고…";
"chap02_seerorcairn13" = "어떤 재앙이 선돌을 만든 자들을 사라지게 한 것일까?";

"chap02_seerorcairn14" = "뒤에서 프레이야가 부르는 소리가 들린다.";
"chap02_seerorcairn15" = "던컨!";
"chap02_seerorcairn16" = "던컨은 멈춰서 뒤를 돌아본다.";
"chap02_seerorcairn17" = "프레이야가 가볍게 뛰어 그를 따라잡는다.";
"chap02_seerorcairn18" = "에릭도 그들 바로 뒤를 따라오지만, 세 사람은 나머지 일행보다 한참 앞서 있다.";
"chap02_seerorcairn19" = "아, 미안해. 다른 사람들이 뒤처지는 줄 몰랐어.";
"chap02_seerorcairn20" = "아니, 그것 때문이 아니라 저길 봐!";

"chap02_seerorcairn21" = "프레이야가 오른쪽을 가리킨다.";
"chap02_seerorcairn22" = "엎어지면 코 닿을 거리에 뿔 달린 아이 둘이 서 있고, 그중 하나가 일행에게 가까이 오라고 손짓한다.";
"chap02_seerorcairn23" = "그래, 나도 보여."; //Duncan
"chap02_seerorcairn24" = "자기들을 따라오라고 우리에게 손짓하는 것 같아."; //Duncan
"chap02_seerorcairn25" = "그래, 하지만 그러려면 거석이 이어진 길을 벗어나야 해."; //Freya

"chap02_seerorcairn26" = "거석?";
"chap02_seerorcairn27" = "그래, 저 거대한 돌들 말이야. 네가 선돌에서 다음 선돌로 일행을 이끌고 있더라…";
"chap02_seerorcairn28" = "네 스승도 거석에 관해 말해 줬어?";
"chap02_seerorcairn29" = "그렇지는 않아. 어렴풋이 언급한 적이 있는데, 저 돌들을 보니 기억이 났어…";
"chap02_seerorcairn30" = "그래도 숲으로 가는 길잡이로 삼는 게 합리적이라고 생각했지.";
"chap02_seerorcairn31" = "그래? 난 네가 아는 줄 알았어.";
