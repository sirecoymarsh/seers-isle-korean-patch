/*** Chapter 7 — Duncan — Rowan Leaves ***/
"chap07_duncan_rowanleaves01" = "나무 그늘 아래 홀로 남는다.";
"chap07_duncan_rowanleaves02" = "밤이 내린다.";
"chap07_duncan_rowanleaves03" = "실프들은 깊은 밤에 깨어나지만 내 슬픔은 보지도 듣지도 못한다.";
"chap07_duncan_rowanleaves04" = "해가 이미 하늘 높이 오른 뒤에야 결심을 내린다.";
"chap07_duncan_rowanleaves05" = "던컨을 죽게 둘 수 없다.";
"chap07_duncan_rowanleaves06" = "그가 이런 식으로 자신을 희생하게 둘 수는 없어…";
"chap07_duncan_rowanleaves07" = "정상을 향해 달려가 동굴 안으로 들어간다.";
"chap07_duncan_rowanleaves08" = "어린 시절, 루터, 붙잡히던 순간의 환영을 모두 무시한다.";
"chap07_duncan_rowanleaves09" = "무엇도 내 결심을 흔들 수 없다.";
"chap07_duncan_rowanleaves10" = "고원에 도착했을 때 나는 다시 거의 인간이 되어 있다.";
"chap07_duncan_rowanleaves11" = "해가 산 너머로 지고 있다.";
"chap07_duncan_rowanleaves12" = "동굴에서 야영하기로 한다.";
"chap07_duncan_rowanleaves13" = "다음 날 이른 아침 다시 길을 나선다.";
"chap07_duncan_rowanleaves14" = "이번에는 정상에 홀로 도착한다.";
"chap07_duncan_rowanleaves15" = "제니버가 기다리고 있다.";
"chap07_duncan_rowanleaves16" = "그녀가 나무를 돌아 나와 나와 나무 사이에 선다.";
"chap07_duncan_rowanleaves17" = "그녀는 여전히 푸른 드레스를 입고 있지만, 긴 붉은 머리를 풀어헤쳐 야성적인 모습이다.";
"chap07_duncan_rowanleaves18" = "마치 나무의 마법과 하나가 된 듯, 둘은 똑같은 주홍빛 장막에 싸여 있다.";
"chap07_duncan_rowanleaves19" = "더 가까이 오지 마, 로완.";
"chap07_duncan_rowanleaves20" = "네가 무슨 일을 하려는지 알아.";
"chap07_duncan_rowanleaves21" = "제니버, 비켜 줘.";
"chap07_duncan_rowanleaves22" = "제니버는 맨발의 발끝으로 크롬렉의 풀밭을 미끄러지듯 지나, 고양이처럼 우아하게 움직이며 내게 다가온다.";
"chap07_duncan_rowanleaves23" = "그녀가 내 눈을 똑바로 바라본다.";
"chap07_duncan_rowanleaves24" = "나도 매섭게 마주 본다.";
"chap07_duncan_rowanleaves25" = "널 보내 줄 수 없어, 로완. 미안해.";
"chap07_duncan_rowanleaves26" = "예언자들이 우리를 에워싸고 크롬렉 안으로 들어오기 시작한다.";
"chap07_duncan_rowanleaves27" = "기묘한 웅얼거림이 공기를 채운다.";
"chap07_duncan_rowanleaves28" = "나무를 향해 몸을 던지려는 순간, 크롬렉 입구에서 거칠고 힘찬 목소리가 울린다.";
"chap07_duncan_rowanleaves29" = "제니버!"; //Erik
"chap07_duncan_rowanleaves30" = "놀라움에 몸이 굳는다.";
"chap07_duncan_rowanleaves31" = "예언자들도 멈춘 뒤 뒤로 물러난다.";
"chap07_duncan_rowanleaves32" = "에릭이 가까이 와서 내게 말을 건다."; //Erik n'a plus son épée.

"chap07_duncan_rowanleaves33" = "로완… 맞지?";
"chap07_duncan_rowanleaves34" = "나를 집어삼킨 분노를 억누르려 이를 악문 채 고개를 끄덕인다.";
"chap07_duncan_rowanleaves35" = "던컨 일은 미안해…";
"chap07_duncan_rowanleaves36" = "나는…";
"chap07_duncan_rowanleaves37" = "에릭이 눈을 내리깐다.";
"chap07_duncan_rowanleaves38" = "내가 틀렸어.";
"chap07_duncan_rowanleaves39" = "던컨이… 나한테 약속을 받아 냈어.";
"chap07_duncan_rowanleaves40" = "제발, 제니버. 로완을 보내 줘.";
"chap07_duncan_rowanleaves41" = "예언자들이 네 가족을 돌려주지는 않아.";
"chap07_duncan_rowanleaves42" = "넌 이제 주술사야.";
"chap07_duncan_rowanleaves43" = "치유사이기도 하고.";
"chap07_duncan_rowanleaves44" = "네 재능은 죽음이 아니라 생명을 위해 쓰여야 해.";
"chap07_duncan_rowanleaves45" = "제니버의 얼굴에 의심의 그림자가 스친다.";
"chap07_duncan_rowanleaves46" = "에릭은 그 틈을 타 그녀를 끌어안는다.";
"chap07_duncan_rowanleaves47" = "그녀가 들고 있던 단검을 떨어뜨리고 흐느끼기 시작한다.";
"chap07_duncan_rowanleaves48" = "에릭이 내게 크롬렉을 떠나라는 몸짓을 보낸다.";
"chap07_duncan_rowanleaves49" = "더 싸울 마음이 없다.";
"chap07_duncan_rowanleaves50" = "새로운 순환을 시작한 끝에 던컨을 또다시 잃는 일을 견딜 힘은 없다.";
"chap07_duncan_rowanleaves51" = "입구에서 기다리던 프레이야와 만난다.";
"chap07_duncan_rowanleaves52" = "그녀가 우리를 보며 미소 짓는다.";
"chap07_duncan_rowanleaves53" = "에릭, 제니버, 그리고 나는 말없이 산을 내려간다.";
"chap07_duncan_rowanleaves54" = "던컨을 위해 판 무덤 근처에서 야영한다.";
"chap07_duncan_rowanleaves55" = "그날 저녁 프레이야가 우리를 따라잡는다.";
"chap07_duncan_rowanleaves56" = "다음 날 해변에 도착하자 브랜던이 배에서 우리를 기다리고 있다.";
"chap07_duncan_rowanleaves57" = "우리는 배에 오른다.";
"chap07_duncan_rowanleaves58" = "순풍이 우리를 해안에서 빠르게 멀리 실어 나른다.";
"chap07_duncan_rowanleaves59" = "선미에 남아 섬이 조금씩 멀어지는 모습을 바라본다.";
"chap07_duncan_rowanleaves60" = "섬이 안개 속으로 사라져 시야에서 완전히 없어진 뒤에야 한숨을 내쉰다.";
"chap07_duncan_rowanleaves61" = "그리고 뱃머리 너머, 미래를 향해 고개를 돌린다.";
"chap07_duncan_rowanleaves62" = "마침내 자유다.";
//-> The End.
/*** Chapter 7 — Duncan — Rowan Dies ***/
"chap07_duncan_rowandies01" = "던컨은 에릭의 시신 곁에 남는다.";
"chap07_duncan_rowandies02" = "충격에 빠졌지만 살아 있다.";
"chap07_duncan_rowandies03" = "중요한 건 그것뿐이다.";
"chap07_duncan_rowandies04" = "예언자들이 공터로 들어와 전사의 움직이지 않는 시신을 옮겨 간다.";
"chap07_duncan_rowandies05" = "일행은 다시 길을 떠난다.";
"chap07_duncan_rowandies06" = "그들이 야영하는 동안 멀찍이 떨어져 있는다.";
