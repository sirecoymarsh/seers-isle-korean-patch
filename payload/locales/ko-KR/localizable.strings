"chap02_bivouac43_duncan" = "정말 네 선택이 네 의지에서 나온 것이라고 확신해?";
"chap02_bivouac44_duncan" = "던컨은 어떻게 반응해야 할지 몰라 한다.";
"chap02_bivouac45_duncan" = "제니버? 괜찮아?"; //Duncan 

"chap02_bivouac41_freya" = "그러고는 프레이야를 돌아본다."; 
"chap02_bivouac42_freya" = "밤에 들리는 속삭임을 경계해.";
"chap02_bivouac43_freya" = "정말 네 선택이 네 의지에서 나온 것이라고 확신해?";
"chap02_bivouac44_freya" = "프레이야는 어떻게 반응해야 할지 몰라 한다.";
"chap02_bivouac45_freya" = "제니버? 괜찮아?"; //Freya

"chap02_bivouac46" = "제니버는 밤의 어둠을 응시한다.";
"chap02_bivouac47" = "너는 성스러운 불꽃을 받을 자격이 없다.";
"chap02_bivouac48" = "시간의 매듭이 묶이고 풀려도, 너는 아무것도 바꾸지 못해.";
"chap02_bivouac49" = "네 운명을 받아들이고 우리를 떠나게 해 줘.";
"chap02_bivouac50" = "코너가 제니버의 팔을 붙잡고 부드럽게 흔든다.";
"chap02_bivouac51" = "제니버?";
"chap02_bivouac52" = "제니버는 잠시 혼란스러워하다가 미소를 짓는다.";
"chap02_bivouac53" = "응?";
"chap02_bivouac54" = "누구와 이야기하고 있었어?";
"chap02_bivouac55" = "내가? 아무와도 이야기하지 않았는데.";
"chap02_bivouac56" = "그냥 알린의 연주를 듣고 있었어.";
"chap02_bivouac57" = "고마워, 알린. 정말 멋졌어.";
"chap02_bivouac58" = "기억나지 않아?";
"chap02_bivouac59" = "제니버의 놀란 표정이 걱정으로 바뀐다.";
"chap02_bivouac60" = "무엇을 기억하지 못한다는 거야?";
"chap02_bivouac61" = "코너는 어떻게 해야 할지 아는 사람이 있기를 바라며 다른 이들을 돌아본다.";
"chap02_bivouac62" = "다른 이들도 코너만큼이나 어찌할 바를 모른다.";

"chap02_bivouac63_choice01_option" = "계속 캐묻는다."; //Prometheus
"chap02_bivouac63_choice01_01" = "매듭과 성스러운 불꽃에 관해 말했잖아. 기억나지 않아?";
"chap02_bivouac63_choice01_02" = "아니… 정말 미안해. 피곤해서 그랬나 봐."; //Jennyver
"chap02_bivouac63_choice01_03" = "모두 지쳤겠지만, 오늘 일어난 일로 동요한 사람은 나뿐이야?";
"chap02_bivouac63_choice01_04" = "내 말은, 너희 중에는 이 섬에서 치를 여정을 미리 준비한 사람도 있잖아…";
"chap02_bivouac63_choice01_05" = "너희가 틈만 나면 지적했듯 난 도시 출신이야. 특히 몇몇은 더 심했지…";
"chap02_bivouac63_choice01_06" = "코너는 어느새 잠든 듯한 에릭을 흘겨본다.";
"chap02_bivouac63_choice01_07" = "잘 들어, 코너. 우리가 주술사가 될 준비를 조금 더 받았을지는 몰라도 아는 건 너와 다를 바 없어."; //Duncan
"chap02_bivouac63_choice01_08" = "섬에서 일어나는 일은 금기야. 선대들도 말할 수 없었고, 우리 역시 입을 다물어야 할 거야…";
"chap02_bivouac63_choice01_09" = "뭐, 정상에 올라 성스러운 불꽃을 받는 사람들은 말이지…";
"chap02_bivouac63_choice01_10" = "언젠가는 모든 일이 분명해지겠지…"; //Freya
"chap02_bivouac63_choice01_11" = "하지만 그때까지는 예언자들을 믿어야 해."; //Freya
"chap02_bivouac63_choice01_12" = "애초에 다른 선택지가 있는 것도 아니잖아."; //Freya
"chap02_bivouac63_choice01_13" = "프레이야 말이 맞아…"; //Jennyver
"chap02_bivouac63_choice01_14" = "좀 쉬는 게 좋겠어.";
"chap02_bivouac63_choice01_15" = "밤새 깨어 있는다고 답을 찾을 수 있는 건 아니니까.";

"chap02_bivouac63_choice02_option" = "제니버를 안심시킨다."; //Gaia
"chap02_bivouac63_choice02_01" = "아무것도 아니야.";
"chap02_bivouac63_choice02_02" = "잠깐 정신을 놓았던 것뿐이야.";
"chap02_bivouac63_choice02_03" = "피곤해서 그랬나 봐.";
"chap02_bivouac63_choice02_04" = "어쨌든 우리 모두 지쳤어. 좀 쉬는 게 좋겠어.";
"chap02_bivouac63_choice02_05" = "그래, 네 말이 맞아. 계속 깨어 있는 건 현명하지 않겠지."; //Connor

"chap02_bivouac64" = "제니버는 불가에 누워 눈을 감는다.";
"chap02_bivouac65" = "다른 이들도 똑같이 자리를 잡는다.";
"chap02_bivouac66" = "코너는 잠시 불길을 바라본다.";
"chap02_bivouac67" = "예언자와 거석, 바다 괴물이 살아가는 이 기묘한 세계는 신전에서의 일상과 너무나도 동떨어져 있다.";
"chap02_bivouac68" = "신전의 방에 갇혀 종소리에 따라 어김없이 흘러가는 나날을 수년간 보낸 뒤라, 섬의 거친 광야가 거의 두렵게 느껴진다.";
"chap02_bivouac69" = "코너는 자신이 왜 이곳에 보내졌는지 아직도 이해하지 못한다…";
"chap02_bivouac70" = "정말 신전의 지배력을 굳히기 위해 자신이 완수해야 할 임무와 중대한 역할이 있는 걸까?";
"chap02_bivouac71" = "아니면 세속 당국이 자신을 어떻게 처리해야 할지 몰라 그저 이곳으로 보낸 것일까?";
"chap02_bivouac72" = "코너는 혼자 어깨를 으쓱한다.";
"chap02_bivouac73" = "그러고는 다른 이들처럼 잠을 청하며 불 가까이 몸을 웅크린다.";
//-> Stage: "chap02_night"

/*** Chapter 2 — Night / POV: Rowan ***/

"chap02_night01" = "나는 불길이 잉걸불로 사그라드는 모습을 지켜보았다.";
"chap02_night02" = "한밤중에 황야를 떠도는 예언자들과 마주치지 않으려고 몸을 숨겼다.";
"chap02_night03" = "아직은 준비되지 않았다.";
"chap02_night04" = "인간들이 깊이 잠든 틈을 타 예언자들이 원정대 가까이 다가오자, 나는 고래의 만으로 돌아갔다.";
"chap02_night05" = "내 영역의 가장자리인 이곳에서는 날개를 잃은 실프처럼 거의 투명하고 가볍다.";
"chap02_night06" = "하지만 파도 위에 비친 달빛과 소금 향이 밴 공기는 기억 속 모습 그대로 생생하여, 지친 내게 되찾을 자유를 약속하는 듯하다.";
"chap02_night07" = "예언자들이 육신을 살피는 일을 마쳤다고 확신한 뒤, 나는 잠재적인 구원자들을 지키려고 황야로 돌아간다.";
"chap02_night08" = "제니버가 사라졌다.";
"chap02_night09" = "예언자들이 제니버를 붙잡아 일행에게서 떼어 놓은 게 분명하다.";
"chap02_night10" = "멀리, 해 뜨기 직전의 구릿빛 어둠 속에서 제니버가 돌로 둘러친 원을 향하는 모습이 보인다.";

"chap02_night10_choice01_option" = "던컨을 깨운다."; //Duncan++
"chap02_night10_choice01_01" = "던컨의 꿈은 늑대와 눈으로 가득하다.";
"chap02_night10_choice01_02" = "정체를 알 수 없는 박해자와 몸부림치며 싸우는 던컨의 이마에 차가운 땀이 송골송골 맺힌다.";
"chap02_night10_choice01_03" = "유령 같은 손길로 던컨을 어루만지며 내면의 어둠을 벗어나 지하 세계에서 수면 위로 떠오르라고 명한다.";
"chap02_night10_choice01_04" = "던컨이 공포에 질려 눈을 뜬다.";
"chap02_night10_choice01_05" = "다른 일행은 여전히 깊이 잠들어 있다.";
"chap02_night10_choice01_06" = "그러다 던컨은 제니버가 없다는 걸 알아차린다.";
"chap02_night10_choice01_07" = "벌떡 일어나 크롬렉을 향해 달린다.";
"chap02_night10_choice01_08" = "너무 늦기 전에 제니버를 따라잡으려면 시간이 얼마 없다는 걸 안다.";
"chap02_night10_choice01_09" = "어떻게 아는지는 확신하지 못하지만, 그렇다고 행동하겠다는 결의가 꺾이지는 않는다.";
"chap02_night10_choice01_10" = "나는 경계심도 잊은 채 던컨을 따라간다.";
"chap02_night10_choice01_11" = "이제 크롬렉이 가까이 보인다.";
"chap02_night10_choice01_12" = "공기에서 천둥 냄새가 난다.";
