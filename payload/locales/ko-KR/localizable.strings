/*** Chapter 7 — Freya — Jennyver Dies ***/
"chap07_freya_jennyverdies01" = "다음 날, 제니버는 사라졌다.";
"chap07_freya_jennyverdies02" = "일행은 숲으로 들어간다.";
"chap07_freya_jennyverdies03" = "대열 앞쪽에서 말다툼이 벌어진다.";
"chap07_freya_jennyverdies04" = "던컨이 공터로 들어선다.";
"chap07_freya_jennyverdies05" = "코너를 지킨다.";
"chap07_freya_jennyverdies06" = "에릭이 그에게 결투를 건다.";
"chap07_freya_jennyverdies07" = "두 사람이 공격을 주고받는다.";
"chap07_freya_jennyverdies08" = "던컨이 땅에 쓰러진다.";
"chap07_freya_jennyverdies09" = "에릭이 그를 죽이려 검을 치켜든다.";
"chap07_freya_jennyverdies10" = "프레이야는 소리 없이 에릭의 뒤로 다가간다.";
"chap07_freya_jennyverdies11" = "치명타를 날리기 전에 그의 손목을 붙잡는다.";
"chap07_freya_jennyverdies12" = "에릭의 불안정한 자세를 이용해 검을 놓게 한다.";
"chap07_freya_jennyverdies13" = "그의 긴 클레이모어가 공터의 부드러운 흙에 박힌다.";
"chap07_freya_jennyverdies14" = "에릭이 격분해 몸을 홱 돌린다.";
"chap07_freya_jennyverdies15" = "상대가 프레이야임을 깨닫자, 너무 쉽게 저지당한 것이 부끄러운 듯 눈을 내리깐다.";
"chap07_freya_jennyverdies16" = "앞으로 닥칠 시련을 위해 힘을 아껴 두는 게 낫지 않겠어?"; //freya
"chap07_freya_jennyverdies17" = "프레이야가 의미심장한 눈길을 보낸다.";
"chap07_freya_jennyverdies18" = "던컨이 몸을 굴려 일어선다.";
"chap07_freya_jennyverdies19" = "코너가 사라진 것을 가장 먼저 알아차린다.";
"chap07_freya_jennyverdies20" = "알린은 나머지 일행이 계속 오르는 동안 자신이 코너를 찾아보겠다고 한다.";
"chap07_freya_jennyverdies21" = "다시 한번 프레이야는 일행이 잠들 때까지 기다렸다가 나를 만나러 온다.";
"chap07_freya_jennyverdies22" = "이번에는 짐도 챙겨 왔다.";
"chap07_freya_jennyverdies23" = "달빛이 충분히 밝아 계속 올라갈 수 있다."; //freya
"chap07_freya_jennyverdies24" = "우리가 충분히 서두르면…";
"chap07_freya_jennyverdies25" = "예언자들이 다른 이들을 데려가기 전에 정상에 도착할 수 있을지도 몰라.";
"chap07_freya_jennyverdies26" = "서두르면 내일 정오에는 도착할 거야.";
"chap07_freya_jennyverdies27" = "다른 사람들에게 경고했어?";
"chap07_freya_jennyverdies28" = "뭐라고 말해?";
"chap07_freya_jennyverdies29" = "앞으로 벌어질 모든 일이 이미 벌어졌다고?";
"chap07_freya_jennyverdies30" = "원정대의 여덟 번째 일원을 나만 볼 수 있고, 그 사람이 예언자들의 세계에 갇혀 있다고?";
"chap07_freya_jennyverdies31" = "프레이야는 빠른 걸음으로 나아간다.";
"chap07_freya_jennyverdies32" = "동굴에 도착한다.";
"chap07_freya_jennyverdies33" = "프레이야는 창을 움켜쥐고 망설임 없이 들어간다.";
"chap07_freya_jennyverdies34" = "산에서 쏟아지는 급류처럼 누구도 막을 수 없어 보인다.";
"chap07_freya_jennyverdies35" = "저 단호한 겉모습 뒤에 무엇이 숨었는지 모르겠다.";
"chap07_freya_jennyverdies36" = "확실한 건 프레이야가 우리 둘의 운명을 책임지기로 결심했다는 것뿐이다.";
"chap07_freya_jennyverdies37" = "동굴 반대편으로 나왔을 때 해가 떠오르고 있다.";
"chap07_freya_jennyverdies38" = "숨을 돌리려고 잠시 멈춘다.";
"chap07_freya_jennyverdies39" = "프레이야의 속내를 떠본다.";
"chap07_freya_jennyverdies40" = "프레이야… 대체 뭘 하려는 거야?";
"chap07_freya_jennyverdies41" = "프레이야는 잠시 말이 없다.";
"chap07_freya_jennyverdies42" = "그러다 내게 다가와 양어깨를 잡는다.";
"chap07_freya_jennyverdies43" = "걱정하지 마, 로완.";
"chap07_freya_jennyverdies44" = "널 지키려면 무엇을 해야 하는지 알아.";
"chap07_freya_jennyverdies45" = "당황한 채 시선을 돌린다.";
"chap07_freya_jennyverdies46" = "왜 날 지키려는 거야?";
"chap07_freya_jennyverdies47" = "우리는 서로 거의 모르잖아.";
"chap07_freya_jennyverdies48" = "프레이야가 미소 짓는다.";
"chap07_freya_jennyverdies49" = "너는 이런 일을 당할 이유가 없어, 로완.";
"chap07_freya_jennyverdies50" = "예언자들 때문에 그토록 고통받고도 계속 우리를 구하려 하잖아?";
"chap07_freya_jennyverdies51" = "당연히 널 풀어 주려고 내 힘이 닿는 데까지 뭐든 해야지!";

"chap07_freya_jennyverdies52" = "몇 시간 뒤, 불꽃나무 가까이에 이른다.";
"chap07_freya_jennyverdies53" = "정상 바닥을 뒤덮은 만년설은 돌로 둘러친 원 앞에서 끊기고, 그 안에는 포근한 풀밭이 펼쳐져 있다.";
"chap07_freya_jennyverdies54" = "경계 안으로 들어서자 살을 에는 산 공기가 여름 저녁의 부드러운 온기로 바뀐다.";
"chap07_freya_jennyverdies55" = "머리 위로 나뭇가지가 하늘을 가려, 마치 진홍빛 천개 아래로 들어온 듯하다.";
"chap07_freya_jennyverdies56" = "나무에서 흘러나오는 듯한 마력의 물결이 공기를 금속성 광택으로 일렁이게 한다.";
"chap07_freya_jennyverdies57" = "크롬렉 반대편에서 예언자 무리가 두 세계 사이의 고요한 공간에 꼼짝 않고 서서 우리가 다가오는 모습을 지켜본다.";
"chap07_freya_jennyverdies58" = "이번에는 아무도 프레이야에게 성스러운 불꽃을 건네러 다가오지 않는다.";
"chap07_freya_jennyverdies59" = "하지만 이전 순환에서처럼 제니버가 나타난다.";
"chap07_freya_jennyverdies60" = "그녀는 여전히 푸른 드레스를 입고 있지만, 긴 붉은 머리를 풀어헤쳐 야성적인 모습이다.";
"chap07_freya_jennyverdies61" = "마치 나무의 마법과 하나가 된 듯, 그녀와 나무는 똑같은 주홍빛 장막에 싸여 있다.";
"chap07_freya_jennyverdies62" = "로완, 제발 돌아가 줘.";
"chap07_freya_jennyverdies63" = "넌 여기 있으면 안 돼…";
"chap07_freya_jennyverdies64" = "…그리고 네가 하려는 일이 뭔지도 알아.";
"chap07_freya_jennyverdies65" = "대답하려 입을 열지만 프레이야가 먼저 단호하게 제니버를 향해 나아간다.";
"chap07_freya_jennyverdies66" = "프레이야의 확신에 찬 태도에 당황한 제니버가 한 걸음 물러난다.";
"chap07_freya_jennyverdies67" = "프레이야?"; //Jennyver
"chap07_freya_jennyverdies68" = "제발 이 일에서 빠져.";
"chap07_freya_jennyverdies69" = "예언자들은 너도 선택했어.";
"chap07_freya_jennyverdies70" = "다른 삶이었다면, 어쩌면 그랬겠지.";
"chap07_freya_jennyverdies71" = "하지만 이번 삶에서는 신경 쓰지 않기로 했어.";
"chap07_freya_jennyverdies72" = "예언자들이 로완에게 가한 고통을 더는 묵인할 수 없어.";
"chap07_freya_jennyverdies73" = "평생 그들을 맹목적으로 믿었지만, 이제는 아니야.";
"chap07_freya_jennyverdies74" = "프레이야가 예언자들을 돌아보며 외친다.";
"chap07_freya_jennyverdies75" = "우리를 보내 줘!";
"chap07_freya_jennyverdies76" = "예언자들은 잠시 움직이지 않다가 크롬렉 가장자리에 원을 이루고 지팡이로 땅을 두드린다.";
"chap07_freya_jennyverdies77" = "수정처럼 맑은 웅얼거림이 울려 퍼지고, 규칙적인 지팡이 소리가 땅에 메아리치며 장단을 넣는다.";
"chap07_freya_jennyverdies78" = "배 속에 둔탁한 통증 덩어리가 퍼지는 게 느껴진다.";
"chap07_freya_jennyverdies79" = "나도 모르게 고통스러운 비명이 터져 나온다.";
"chap07_freya_jennyverdies80" = "프레이야가 나를 돌아본다.";
"chap07_freya_jennyverdies81" = "로완?!";
"chap07_freya_jennyverdies82" = "제니버는 모두의 시선이 흐트러진 틈을 타 드레스 주름에 숨긴 긴 단검을 꺼낸다.";
"chap07_freya_jennyverdies83" = "통증에 비틀거린다.";
"chap07_freya_jennyverdies84" = "제니버가 칼날을 치켜든다.";
"chap07_freya_jennyverdies85" = "이번에는 프레이야가 준비되어 있다. 몸을 돌려 제니버의 공격을 막는다.";
"chap07_freya_jennyverdies86" = "두 젊은 여자가 사납게 맞붙지만 프레이야가 우세하다.";
"chap07_freya_jennyverdies87" = "패배를 인정하지 않을 제니버를 죽이는 수밖에 없다.";
"chap07_freya_jennyverdies88" = "아니면…?";

"chap07_freya_jennyverdies89_choice01_option" = "순환을 다시 시작한다.";
"chap07_freya_jennyverdies89_choice01_01" = "힘을 모두 끌어모아 나무를 향해 기어간다.";
"chap07_freya_jennyverdies89_choice01_02" = "예언자들은 나를 늦출 수는 있어도 막을 수는 없다.";
"chap07_freya_jennyverdies89_choice01_03" = "내가 해야 할 일이 뭔지 알아.";
"chap07_freya_jennyverdies89_choice01_04" = "프레이야가 이런 식으로 주술사로서의 미래를 희생하게 둘 수는 없다.";
"chap07_freya_jennyverdies89_choice01_05" = "두 걸음만 더 가면 불꽃나무다.";
"chap07_freya_jennyverdies89_choice01_06" = "나무줄기의 옹이 안으로 손을 찔러 넣는다.";
"chap07_freya_jennyverdies89_choice01_07" = "나무껍질 안은 구역질 날 만큼 끈적하고 따뜻하다. 나무의 형상 안에 어떤 짐승 같은 생명이 숨겨져 있는 듯하다.";
"chap07_freya_jennyverdies89_choice01_08" = "고동치는 나무의 심장을 뜯어낸다.";
"chap07_freya_jennyverdies89_choice01_09" = "지체할 여유가 없다.";
"chap07_freya_jennyverdies89_choice01_10" = "프레이야와 제니버가 불과 몇 걸음 앞에서 서로 엉켜 싸운다.";
"chap07_freya_jennyverdies89_choice01_11" = "예언자들의 노래가 공중으로 솟아 대지에 울려 퍼지고, 원소들이 그 부름에 응답하는 듯하다.";
//-> followed by: "chap07_freya_thesummit106" -> "chap07_freya_thesummit131"
//-> then, stage: "chap07_freya_timeknot"


"chap07_freya_jennyverdies89_choice02_option" = "일이 흘러가는 대로 둔다.";
"chap07_freya_jennyverdies89_choice02_01" = "개입하지 않기로 한다.";
"chap07_freya_jennyverdies89_choice02_02" = "프레이야는 이미 결정을 내렸다.";
"chap07_freya_jennyverdies89_choice02_03" = "이번에는 두 젊은 여자의 싸움이 어떻게 끝날지 뻔하다.";
"chap07_freya_jennyverdies89_choice02_04" = "눈 깜짝할 사이 프레이야가 제니버의 무기를 빼앗고 쓰러뜨린다.";
"chap07_freya_jennyverdies89_choice02_05" = "배의 고통이 견딜 수 없을 만큼 심해진다.";
"chap07_freya_jennyverdies89_choice02_06" = "고통에 몸부림치는 사이, 프레이야가 창을 휘두르며 예언자들에게 돌진하는 모습이 보인다.";
"chap07_freya_jennyverdies89_choice02_07" = "그러다 의식을 잃는다.";

"chap07_freya_jennyverdies89_choice02_08" = "다시 눈을 뜨자 눈부신 햇살이 시야를 가린다.";
"chap07_freya_jennyverdies89_choice02_09" = "세상이 좌우로 흔들린다.";
"chap07_freya_jennyverdies89_choice02_10" = "배 위에 있다.";
"chap07_freya_jennyverdies89_choice02_11" = "누군가 내 위로 몸을 숙이고 있다.";
"chap07_freya_jennyverdies89_choice02_12" = "깨어났어!"; //Arlyn
"chap07_freya_jennyverdies89_choice02_13" = "난간을 붙잡고 몸을 일으킨다.";
"chap07_freya_jennyverdies89_choice02_14" = "좌현으로 섬의 절벽이 보이고, 그 너머에는 송곳니처럼 하늘을 찌르는 정상이 보인다.";
"chap07_freya_jennyverdies89_choice02_15" = "배에는 알린과 브랜던, 코너뿐이다.";
"chap07_freya_jennyverdies89_choice02_16" = "프레이야…"; //Rowan
"chap07_freya_jennyverdies89_choice02_17" = "프레이야는 어디 있어?";
"chap07_freya_jennyverdies89_choice02_18" = "알린은 한숨을 쉬며 내게 물병을 내민다.";
"chap07_freya_jennyverdies89_choice02_19" = "몇 시간 전에 프레이야가 널 해변으로 데려왔어.";
"chap07_freya_jennyverdies89_choice02_20" = "프레이야는 뿔 달린 아이들과… 거대한 흰 수사슴 한 마리와 함께 있었어.";
"chap07_freya_jennyverdies89_choice02_21" = "프레이야가… 무슨 일이 있었는지 말해 줬어? 정상에서?"; //Rowan
"chap07_freya_jennyverdies89_choice02_22" = "그러니까… 내가 정신을 잃은 뒤에?";
"chap07_freya_jennyverdies89_choice02_23" = "알린이 고개를 젓는다.";
"chap07_freya_jennyverdies89_choice02_24" = "제대로 말해 주지는 않았어…";
"chap07_freya_jennyverdies89_choice02_25" = "그저 우리에게 섬을 떠나 달라고 했어.";
"chap07_freya_jennyverdies89_choice02_26" = "나한테 널 돌봐 달라고 약속시키고…";
"chap07_freya_jennyverdies89_choice02_27" = "…자신은 우리와 함께 떠나려 하지 않았어.";
"chap07_freya_jennyverdies89_choice02_28" = "던컨과 에릭은?";
"chap07_freya_jennyverdies89_choice02_29" = "알린은 걱정스러운 표정으로 고개를 젓는다.";
"chap07_freya_jennyverdies89_choice02_30" = "모르겠어…";
"chap07_freya_jennyverdies89_choice02_31" = "프레이야는 그들 걱정은 하지 않아도 된다고 했어.";
"chap07_freya_jennyverdies89_choice02_32" = "내가 아는 건 그게 전부야.";
"chap07_freya_jennyverdies89_choice02_33" = "순풍이 우리를 해안에서 빠르게 멀리 실어 나른다.";
"chap07_freya_jennyverdies89_choice02_34" = "프레이야가 나를 풀어 주려고 예언자들과 어떤 거래를 했는지는 모르지만…";
"chap07_freya_jennyverdies89_choice02_35" = "…한 가지는 확실하다. 나는 영원히 프레이야에게 감사할 것이다.";
"chap07_freya_jennyverdies89_choice02_36" = "언젠가 프레이야에게 고맙다고 말할 기회가 올까?";
"chap07_freya_jennyverdies89_choice02_37" = "선미에 남아 섬이 점점 멀어지는 모습을 바라본다.";
"chap07_freya_jennyverdies89_choice02_38" = "섬이 안개 속으로 사라져 시야에서 완전히 없어진 뒤에야 한숨을 내쉰다.";
"chap07_freya_jennyverdies89_choice02_39" = "그리고 뱃머리 너머, 미래를 향해 고개를 돌린다.";
"chap07_freya_jennyverdies89_choice02_40" = "마침내 자유다.";



/*** Chapter 7 — Freya — Rowan Dies ***/
"chap07_freya_rowandies01" = "다음 날, 제니버는 사라졌다.";
"chap07_freya_rowandies02" = "일행은 숲으로 들어간다.";
"chap07_freya_rowandies03" = "대열 선두에서 말다툼이 벌어진다.";
"chap07_freya_rowandies04" = "던컨이 공터로 들어선다.";
"chap07_freya_rowandies05" = "코너를 지킨다.";
"chap07_freya_rowandies06" = "에릭이 그에게 결투를 건다.";
"chap07_freya_rowandies07" = "두 사람이 공격을 주고받는다.";
"chap07_freya_rowandies08" = "던컨이 땅에 쓰러진다.";
"chap07_freya_rowandies09" = "에릭이 그를 죽이려 검을 치켜든다.";
"chap07_freya_rowandies10" = "이번에는 내가 끼어들 틈도 없이 프레이야가 던컨을 구하려 이미 화살을 쏘았다.";
"chap07_freya_rowandies11" = "예언자들과 수사슴이 시신을 거두러 온다.";
"chap07_freya_rowandies12" = "일행은 다시 출발하고 밤을 보낼 야영지를 준비한다.";

"chap07_freya_rowandies13" = "그들이 야영하는 동안 멀찍이 떨어져 있는다.";
"chap07_freya_rowandies14" = "다음 날, 동굴로 들어가는 프레이야에게서 한시도 눈을 떼지 않는다.";
"chap07_freya_rowandies15" = "이번에는 프레이야가 무엇이 기다리는지 알고 시련에서 승리해 돌아온다.";
"chap07_freya_rowandies16" = "계속 고원으로 올라가 동굴에서 쉰다.";
"chap07_freya_rowandies17" = "다음 날, 나는 다시 거의 인간이 되어 있다.";
"chap07_freya_rowandies18" = "순환을 끊으려면 무엇을 해야 하는지 안다.";
"chap07_freya_rowandies19" = "하지만 내 안에서 그럴 힘을 찾을 수 있을까?";

"chap07_freya_rowandies20" = "정상에 도착하자 예언자들이 프레이야에게 불꽃나무의 열매를 내민다.";
"chap07_freya_rowandies21" = "프레이야가 열매를 깨물기 직전 마음을 바꾸자 제니버가 나타난다.";
"chap07_freya_rowandies22" = "그녀는 여전히 푸른 드레스를 입고 있지만, 긴 붉은 머리를 풀어헤쳐 야성적인 모습이다.";
"chap07_freya_rowandies23" = "마치 나무의 마법과 하나가 된 듯, 그녀와 나무는 똑같은 주홍빛 장막에 싸여 있다.";
"chap07_freya_rowandies24" = "더 가까이 오지 마, 로완.";
"chap07_freya_rowandies25" = "네가 무슨 일을 하려는지 알아.";
"chap07_freya_rowandies26" = "제니버, 비켜 줘.";
"chap07_freya_rowandies27" = "제니버는 맨발의 발끝으로 크롬렉의 풀밭을 미끄러지듯 지나, 고양이처럼 우아하게 움직이며 내게 다가온다.";
"chap07_freya_rowandies28" = "그녀가 내 눈을 똑바로 바라본다.";
"chap07_freya_rowandies29" = "나도 매섭게 마주 본다.";
"chap07_freya_rowandies30" = "널 보내 줄 수 없어, 로완. 미안해.";
"chap07_freya_rowandies31" = "예언자들은 크롬렉 안에서 우리를 에워싸고 점점 포위망을 좁혀 온다.";
"chap07_freya_rowandies32" = "기묘한 웅얼거림이 공기 중에 퍼진다.";
"chap07_freya_rowandies33" = "현기증이 밀려와 나는 무릎을 꿇는다.";
"chap07_freya_rowandies34" = "프레이야가 그 모습을 본다.";
"chap07_freya_rowandies35" = "프레이야의 얼굴에 놀라움과 불신이 떠오른다.";
"chap07_freya_rowandies36" = "의식을 방해하려 하지 마, 프레이야.";
"chap07_freya_rowandies37" = "네가 로완을 위해 할 수 있는 일은 없어. 미안해.";
"chap07_freya_rowandies38" = "하지만… 안 돼!";
"chap07_freya_rowandies39" = "배의 고통이 거의 견딜 수 없을 만큼 심해진다.";
"chap07_freya_rowandies40" = "프레이야는 열매를 떨어뜨리고 두 손으로 창을 잡아 경계 태세를 갖춘다.";
"chap07_freya_rowandies41" = "제니버는 프레이야에게서 눈을 떼지 않은 채 드레스 주름에 숨겨 둔 긴 단검을 꺼낸다.";
"chap07_freya_rowandies42" = "프레이야가 창을 고쳐 잡고 예언자 하나에게 던질 준비를 한다.";
"chap07_freya_rowandies43" = "이건 불공평해!"; //Freya
"chap07_freya_rowandies44" = "나… 난 네가 이렇게 하게 둘 수 없어.";

"chap07_freya_rowandies45" = "지금 아니면 기회가 없다.";
"chap07_freya_rowandies46" = "프레이야를 구하려 개입하지 않으면 모든 것이 또다시 처음부터 시작될 것이다.";

"chap07_freya_rowandies47_choice01_option" = "프레이야를 구하려 자신을 희생한다.";
"chap07_freya_rowandies47_choice01_01" = "용기를 끌어모아…";
"chap07_freya_rowandies47_choice01_02" = "…제니버가 프레이야의 빈틈을 노려 공격하기 전에…";
"chap07_freya_rowandies47_choice01_03" = "두 사람 사이로 몸을 던진다.";
"chap07_freya_rowandies47_choice01_04" = "칼날이 살을 파고드는 게 느껴진다.";
"chap07_freya_rowandies47_choice01_05" = "제니버가 충격에 찬 비명을 지른다.";
"chap07_freya_rowandies47_choice01_06" = "무릎을 꿇는다.";
"chap07_freya_rowandies47_choice01_07" = "제니버도 나와 함께 쓰러진다.";
"chap07_freya_rowandies47_choice01_08" = "프레이야는 창을 떨어뜨린 채 아무것도 하지 못하고 나와 제니버를 바라본다.";
"chap07_freya_rowandies47_choice01_09" = "세상이 빙빙 돈다.";
"chap07_freya_rowandies47_choice01_10" = "바닥에 쓰러진다.";
"chap07_freya_rowandies47_choice01_11" = "머리 위 불꽃나무의 진홍빛 잎이 고지대의 창백한 빛 속에서 일렁이는 듯하다.";
"chap07_freya_rowandies47_choice01_12" = "배에서 피가 빠져나가듯 생명이 몸을 떠나 흘러나가는 것을 느낀다.";
"chap07_freya_rowandies47_choice01_13" = "프레이야의 손이 내 이마를 어루만지는 게 느껴진다.";
"chap07_freya_rowandies47_choice01_14" = "프레이야는 뺨을 타고 흐르는 눈물 속에서도 애써 미소 지으려 한다.";
"chap07_freya_rowandies47_choice01_15" = "나도 프레이야에게 미소를 돌려준다.";
"chap07_freya_rowandies47_choice01_16" = "그리고 망각이 나를 온전히 집어삼킨다.";
//-> The End 


