"chap04_duncantrial98_choice01_option" = "공격한다."; //Prometheus
"chap04_duncantrial98_choice01_01" = "던컨은 깊이 숨을 들이마시고 적에게 몸을 던져, 방어를 무너뜨리려 검을 휘두른다.";
"chap04_duncantrial98_choice01_02" = "다시는 가족의 조롱과 멸시를 받는 존재가 되지 않을 것이다.";
"chap04_duncantrial98_choice01_03" = "그가 바란 것은 그저 아버지와 형들, 부족의 명예를 빛내는 일이었다.";
"chap04_duncantrial98_choice01_04" = "그저 자신이 설 자리를 찾도록 내버려 두길 바랐을 뿐이다.";
"chap04_duncantrial98_choice01_05" = "어린 시절 그는 아버지의 감당할 수 없는 기대에서 벗어나 잠시라도 숨을 돌리려고 삼촌의 서재에서 시간을 보내곤 했다.";
"chap04_duncantrial98_choice01_06" = "가장 아끼던 책을 집어삼킨 불길을 떠올리자, 뜻밖의 힘이 솟는다.";
"chap04_duncantrial98_choice01_07" = "늑대들의 울음은 전쟁 노래처럼 귓가에 울려 그를 고무한다.";
"chap04_duncantrial98_choice01_08" = "그는 이제 아버지의 그림자에 불과한 남자에게 달려든다.";
