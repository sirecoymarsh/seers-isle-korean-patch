"chap03_erikdeath52" = "맞아."; //Freya
"chap03_erikdeath53" = "그렇다면 예언자들이 날 자격 있다고 본다면, 내가 그들을 배신하지 않을 사람이기 때문이겠지…";
"chap03_erikdeath54" = "반대로 자격이 없다면 등정을 마치지 못할 테고. 내 말이 맞지?";
"chap03_erikdeath55" = "논리적으로는 그래."; //Freya
"chap03_erikdeath56" = "그럼 걱정할 필요 없잖아.";
"chap03_erikdeath57" = "던컨은 납득하지 못한 표정이다.";

"chap03_erikdeath58" = "좋든 싫든 코너는 우리 원정대의 일원이야."; //Arlyn
"chap03_erikdeath59" = "누가 여기 있을 자격이 더 있는지 다투는 대신, 이제 에릭을… 수습해야 하지 않을까?";
"chap03_erikdeath60" = "응. 장례 의식을 지켜야 해."; //Freya
"chap03_erikdeath61" = "전투 중에 죽었으니 최소한 그의 죽음을 기려야 해.";
"chap03_erikdeath62" = "장작더미를 쌓아 화장해야 해.";
"chap03_erikdeath63" = "그럼 한참 걸릴 거야!"; //Connor
"chap03_erikdeath64" = "그냥 묻으면 안 돼?";
"chap03_erikdeath65" = "안 돼."; //Freya
"chap03_erikdeath66" = "그건 우리 관습이 아니야."; //Freya
"chap03_erikdeath67" = "무덤은 무슨 수로 파려고?"; //Duncan
"chap03_erikdeath68" = "도구도 없잖아…";
"chap03_erikdeath69" = "봐!"; //Arlyn

"chap03_erikdeath70" = "작은 존재들이 행렬을 이루어 공터로 들어온다.";
"chap03_erikdeath71" = "순백의 털을 지닌 거대한 수사슴이 그들과 함께한다.";
"chap03_erikdeath72" = "그들은 나를 바라보지만, 내게 맞설 생각은 없어 보인다.";
"chap03_erikdeath73" = "적어도 지금은.";
"chap03_erikdeath74" = "그들은 에릭의 시신을 둘러싸고 깊은 경의를 표하며 무릎을 꿇는다.";
"chap03_erikdeath75" = "알린이 그들에게 말을 걸려는 듯 한 걸음 나선다.";
"chap03_erikdeath76" = "프레이야가 알린의 팔을 붙잡고 눈빛으로 물러서 있으라고 한다.";
"chap03_erikdeath77" = "예언자들이 시신을 수사슴의 등에 싣고 나무 사이로 사라지려 한다.";
"chap03_erikdeath78" = "알린을 이용해 그들을 추궁하거나, 적어도 해명을 요구하게 할 수 있다.";
"chap03_erikdeath79" = "하지만 그러면 나와 알린 모두 위험해질 수도 있다…";
"chap03_erikdeath80" = "그만한 위험을 감수할 가치가 있는지는 모르겠다.";

"chap03_erikdeath81_choice01_option" = "알린을 부추겨 예언자들에게 다가가게 한다."; //Prometheus 
"chap03_erikdeath81_choice01_01" = "알린은 프레이야가 붙잡은 손에서 팔을 빼내고, 다른 이들이 붙잡기도 전에 예언자들을 향해 달려간다.";
"chap03_erikdeath81_choice01_02" = "이봐!"; //Arlyn
"chap03_erikdeath81_choice01_03" = "그중 하나가 알린에게 다가와 멈추라는 신호를 보낸다.";
"chap03_erikdeath81_choice01_04" = "멈춰라."; //The Seer
"chap03_erikdeath81_choice01_05" = "가면 뒤에서 흘러나온 기묘한 목소리에 알린은 그 자리에 멈춰 선다.";
"chap03_erikdeath81_choice01_06" = "종이 울리는 소리 같기도, 나뭇잎 사이를 지나는 바람 소리 같기도 하며, 그 위로 지하에서 울리는 듯한 메아리가 겹쳐진다.";
"chap03_erikdeath81_choice01_07" = "우리에게 원하는 게 뭐야?"; //Arlyn
"chap03_erikdeath81_choice01_08" = "너는 네 것이 아닌 목소리로 말한다.";
"chap03_erikdeath81_choice01_09" = "나는 그 목소리의 추궁에 답하지 않겠다.";
"chap03_erikdeath81_choice01_10" = "이 남자는 죽어서는 안 됐다. 오늘은 아니었다.";
"chap03_erikdeath81_choice01_11" = "예언자는 돌아서서 에릭의 시신을 싣고 공터를 떠나는 행렬에 합류한다.";

"chap03_erikdeath81_choice02_option" = "예언자들을 보내 준다."; //Gaia
"chap03_erikdeath81_choice02_01" = "일행은 꼼짝도 하지 않고, 에릭의 시신을 싣고 공터를 떠나는 행렬을 지켜본다.";

"chap03_erikdeath82" = "이내 그들은 수풀 속으로 자취를 감춘다.";
"chap03_erikdeath83" = "일행은 다시 숲에 홀로 남는다.";

