"chap04_duncantrial98_choice01_16" = "그는 나를 안다.";
"chap04_duncantrial98_choice01_17" = "로완?"; //Duncan


"chap04_duncantrial98_choice02_option" = "항복한다."; //Gaia
"chap04_duncantrial98_choice02_01" = "던컨은 차마 아버지를 공격할 수 없다.";
"chap04_duncantrial98_choice02_02" = "그 모든 일이 있었음에도.";
