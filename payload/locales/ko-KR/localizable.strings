/*** Chapter 3 — Brandon Leaves / POV: Arlyn ***/
"chap03_brandonleaves01" = "침묵을 깨는 사람은 브랜던이다.";
"chap03_brandonleaves02" = "난 포기할게.";
"chap03_brandonleaves03" = "모두가 충격받은 표정으로 브랜던을 돌아본다.";
"chap03_brandonleaves04" = "포기한다니, 무슨 뜻이야?"; //Duncan
"chap03_brandonleaves05" = "해변으로 돌아가서 배를 수리할 거야.";

"chap03_brandonleaves06_choice01_option" = "좋은 생각이야."; //Order
"chap03_brandonleaves06_choice01_01" = "알린이 가까이 다가가 브랜던의 어깨에 손을 얹는다.";
"chap03_brandonleaves06_choice01_02" = "그동안 있었던 일을 생각하면…";
"chap03_brandonleaves06_choice01_03" = "이해해.";

"chap03_brandonleaves06_choice02_option" = "브랜던은 계속 가야 한다."; //Chaos
"chap03_brandonleaves06_choice02_01" = "알린이 가까이 다가가 브랜던의 어깨에 손을 얹는다.";
"chap03_brandonleaves06_choice02_02" = "우리와 계속 가야 해.";
"chap03_brandonleaves06_choice02_03" = "브랜던이 한숨을 쉰다.";
"chap03_brandonleaves06_choice02_04" = "아니, 미안하지만 이미 결정했어.";
"chap03_brandonleaves06_choice02_05" = "저번에도 돌아갈 뻔했어. 제니버가… 제니버에게 그런 일이 있고 나서.";
"chap03_brandonleaves06_choice02_06" = "하지만 이번에는 정말 감당할 수 없어.";

"chap03_brandonleaves07" = "해변으로 돌아가는 길은 찾을 수 있겠어?"; //Freya
"chap03_brandonleaves08" = "응, 그럴 것 같아.";
"chap03_brandonleaves09" = "걸어서 얼마나 걸리지? 길어야 하루 반, 이틀 정도겠지.";
"chap03_brandonleaves10" = "거석을 반대 방향으로 따라가면 갈 수 있을 거야.";
"chap03_brandonleaves11" = "돌아가는 길에 먹을 식량을 나눠 줄게."; //Arlyn
"chap03_brandonleaves12" = "일행은 남은 보급품을 브랜던과 나눈다.";

"chap03_brandonleaves13" = "오늘 저녁 먹을 양은 남았지만 내일은 사냥해야겠어."; //Freya
"chap03_brandonleaves14" = "알린이 미소 짓는다.";
"chap03_brandonleaves15" = "아니면 낚시하거나!";
"chap03_brandonleaves16" = "개울이 있을 테니 연어나 송어를 잡을 수 있을 거야.";
"chap03_brandonleaves17" = "브랜던이 웃음을 터뜨린다.";
"chap03_brandonleaves18" = "그래도 너희는 고기든 물고기든 구할 방법이 있네!";
"chap03_brandonleaves19" = "맛있게 먹을 때 내 생각도 해 줄래?";
"chap03_brandonleaves20" = "난 이틀이나 더 마른 빵과 과일로 버텨야 하거든!";
"chap03_brandonleaves21" = "우리가 나눠 준 게 떨어지면 어떻게 버티려고?"; //Connor
"chap03_brandonleaves22" = "아, 걱정하지 마. 나도 낚시할 줄 알아.";
"chap03_brandonleaves23" = "해변에서 최대한 오래 기다릴게.";
"chap03_brandonleaves24" = "너희가 본토로 돌아갈 수 있도록 배를 고쳐 둘게. 만약 너희가…";
"chap03_brandonleaves25" = "흠흠… 그러니까, 너희가 돌아온다면.";
"chap03_brandonleaves26" = "난 반드시 돌아올 생각이야."; //Connor
"chap03_brandonleaves27" = "알린과 프레이야, 던컨이 말없이 동의한다.";
"chap03_brandonleaves28" = "그럼."; //Brandon
"chap03_brandonleaves29" = "벌써 하루가 많이 지났어. 내일 저녁까지 해변에 도착하려면 꾸물거릴 시간이 없어.";
"chap03_brandonleaves30" = "던컨이 브랜던에게 손을 내밀자 브랜던이 힘주어 맞잡는다.";
"chap03_brandonleaves31" = "조심해."; //Duncan
"chap03_brandonleaves32" = "알린의 눈에 눈물이 고인다.";
"chap03_brandonleaves33" = "감정이 북받친 알린은 브랜던을 두 팔로 감싸 안고 힘껏 끌어안는다.";
"chap03_brandonleaves34" = "알린은 이별을 정말 싫어한다.";
"chap03_brandonleaves35" = "이봐, 살살 해!"; //Brandon
"chap03_brandonleaves36" = "종아리에 이미 전쟁의 상처도 있는데, 갈비뼈까지 부러뜨릴 필요는 없잖아!";
"chap03_brandonleaves37" = "알린이 킥킥 웃으며 눈물을 닦는다.";
"chap03_brandonleaves38" = "우릴 너무 오래 기다리지는 마. 알겠지?"; //Arlyn
"chap03_brandonleaves39" = "일주일 안에 돌아오지 않으면 출항해. 약속해?";
"chap03_brandonleaves40" = "브랜던이 고개를 끄덕인다.";
"chap03_brandonleaves41" = "그럼 이제 내가 할 일은 행운을 빌어 주는 것뿐이네.";
"chap03_brandonleaves42" = "너도 조심해.";
"chap03_brandonleaves43" = "브랜던은 몸을 돌려 왔던 길을 되돌아간다.";
"chap03_brandonleaves44" = "남은 원정대원 네 명은 브랜던이 나무 사이로 사라지는 모습을 지켜본다.";
"chap03_brandonleaves45" = "브랜던이 마음을 바꾸고 돌아올지도 모른다는 말 없는 합의 아래, 모두 잠시 공터에 남아 기다린다."; 
"chap03_brandonleaves46" = "그리고 다시 여정을 이어 간다.";


/*** Chapter 3 — Bivouac / POV: Duncan ***/
"chap03_bivouac_duncan01" = "던컨이 다시 행렬 맨 앞에 선다.";
"chap03_bivouac_duncan02" = "전날 배 위에서는 일곱 명이었지만 이제는 네 명뿐이다.";
"chap03_bivouac_duncan03" = "벌써 모든 일이 아주 먼 옛날처럼 느껴진다…";
"chap03_bivouac_duncan04" = "에릭과 벌인 싸움이 계속 마음에 걸린다…";
"chap03_bivouac_duncan05" = "다른 방법은 없었을지, 어떻게 했다면… 이런 결과를 피할 수 있었을지 곱씹는다.";
"chap03_bivouac_duncan06" = "던컨은 무언가 이상하다는 걸 조금씩 깨닫는다.";
"chap03_bivouac_duncan07" = "프레이야가 바로 뒤에 있다.";
"chap03_bivouac_duncan08" = "던컨은 멈춰 서서 프레이야가 따라잡기를 기다린다.";
"chap03_bivouac_duncan09" = "프레이야?";
"chap03_bivouac_duncan10" = "응?";
"chap03_bivouac_duncan11" = "질문 하나 해도 돼?";
"chap03_bivouac_duncan12" = "그래.";
"chap03_bivouac_duncan13" = "아까 왜 에릭에게 활을 쏜 거야?";
"chap03_bivouac_duncan14" = "프레이야가 당황한 표정을 짓는다.";
"chap03_bivouac_duncan15" = "그러니까, 넌 활을 내렸었잖아.";
"chap03_bivouac_duncan16" = "관습에 따르면 끼어들어서는 안 됐어. 에릭과 나의 일대일 결투였으니까.";

"chap03_bivouac_duncan17_choice01_option" = "프레이야에게 거짓말을 시킨다."; //Chaos
"chap03_bivouac_duncan17_choice01_01" = "나는 프레이야의 정신에 파고들려고 한다.";
"chap03_bivouac_duncan17_choice01_02" = "내가 개입했다는 사실을 말하지 않는 편이 나을 것 같은 느낌이 든다.";
"chap03_bivouac_duncan17_choice01_03" = "프레이야는 잠시 입을 열기를 주저한다.";
"chap03_bivouac_duncan17_choice01_04" = "그러다 마음을 다잡는다.";
"chap03_bivouac_duncan17_choice01_05" = "왜 그래?"; //Duncan
"chap03_bivouac_duncan17_choice01_06" = "가끔 머릿속에서 뭘 하고 무슨 말을 해야 하는지 알려 주는 작은 목소리가 들리는 것 같지 않아?";
"chap03_bivouac_duncan17_choice01_07" = "던컨이 생각에 잠긴다.";
"chap03_bivouac_duncan17_choice01_08" = "응. 네 말을 듣고 보니 섬에 도착한 뒤 그런 느낌을 받은 적이 있어.";
"chap03_bivouac_duncan17_choice01_09" = "방금 그곳에서도 그랬어.";
"chap03_bivouac_duncan17_choice01_10" = "그래? 그 “작은 목소리”가 네게 무슨 말을 하려 했는데?";
"chap03_bivouac_duncan17_choice01_11" = "내가 말하지 못하게 막으려 했던 것 같아.";
"chap03_bivouac_duncan17_choice01_12" = "그리고 내게 활을 쏘게 한 것도 그 “작은 목소리”였던 것 같아.";
"chap03_bivouac_duncan17_choice01_13" = "흠… 그래, 말이 되네.";

"chap03_bivouac_duncan17_choice02_option" = "개입하지 않는다."; //Order
"chap03_bivouac_duncan17_choice02_01" = "프레이야가 생각에 잠긴다.";
"chap03_bivouac_duncan17_choice02_02" = "마치… 어떤 손이 내 화살을 이끈 것 같았어.";
"chap03_bivouac_duncan17_choice02_03" = "아무것도 하지 않고 너와 에릭의 명예를 존중할 생각이었어.";
"chap03_bivouac_duncan17_choice02_04" = "그런데 네가 쓰러지고… 에릭이 마지막 일격을 날리려던 순간…";
"chap03_bivouac_duncan17_choice02_05" = "머릿속의 “작은 목소리”가 내게 활을 쏘도록 강요한 것 같아.";
"chap03_bivouac_duncan17_choice02_06" = "넌 그런 느낌 없었어?";
"chap03_bivouac_duncan17_choice02_07" = "음, 아니. 솔직히 말하면 곧 죽겠다는 느낌만 들었어.";
"chap03_bivouac_duncan17_choice02_08" = "프레이야가 자신도 모르게 미소 짓는다.";
"chap03_bivouac_duncan17_choice02_09" = "아니! 내 말은, 섬에 도착한 뒤 말이야…";
"chap03_bivouac_duncan17_choice02_10" = "머릿속에서 뭘 하고 무슨 말을 해야 하는지 알려 주는 작은 목소리가 들리는 것 같지 않아?";
"chap03_bivouac_duncan17_choice02_11" = "흠…"; //Duncan
"chap03_bivouac_duncan17_choice02_12" = "응, 네 말을 듣고 보니 나도 그런 느낌을 받은 적이 있어…";
"chap03_bivouac_duncan17_choice02_13" = "그 “작은 목소리”가 네게 활을 쏘게 했다는 거야?";
"chap03_bivouac_duncan17_choice02_14" = "응.";

"chap03_bivouac_duncan18_arlyncromlech" = "그날 밤 크롬렉에서 알린이 본 소녀일까?";
"chap03_bivouac_duncan18_connorcromlech" = "그날 밤 크롬렉에서 코너가 본 소녀일까?";
"chap03_bivouac_duncan18_freyacromlech" = "그날 밤 크롬렉에서 네가 본 소녀일까?";
"chap03_bivouac_duncan18_duncancromlech" = "그날 밤 크롬렉에서 내가 본 소녀와 관련이 있을까?";

"chap03_bivouac_duncan19" = "직감으로는 맞는 것 같지만 확신할 수는 없어.";
"chap03_bivouac_duncan20" = "그래도 다른 누가 이런 일을 할 수 있을지는 모르겠어.";
"chap03_bivouac_duncan21" = "모르겠어."; //Duncan
"chap03_bivouac_duncan22" = "하지만 예언자들에게서 들리는 목소리가 아니라는 건 거의 확실해."; //Duncan
"chap03_bivouac_duncan23" = "프레이야가 고개를 끄덕인다.";
