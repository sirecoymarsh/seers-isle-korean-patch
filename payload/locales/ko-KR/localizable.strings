"chap07_duncan_thesummit75" = "지체할 여유가 없다.";
"chap07_duncan_thesummit76" = "몇 걸음 떨어진 땅바닥에서 던컨과 제니버가 몸싸움을 벌인다.";
"chap07_duncan_thesummit77" = "그녀가 몸을 비틀어 그의 손아귀에서 빠져나오지만, 던컨이 발목을 붙잡아 다시 넘어뜨린다.";
"chap07_duncan_thesummit78" = "생각할 시간이 없다.";
"chap07_duncan_thesummit79" = "예언자들의 노래가 공중으로 솟아 대지에 울려 퍼지고, 원소들이 그 부름에 응답하는 듯하다.";
"chap07_duncan_thesummit80" = "흑단빛 심장을 힘껏 깨문다.";
"chap07_duncan_thesummit81" = "번쩍이는 빛에 눈이 멀 듯하다.";
"chap07_duncan_thesummit82" = "빙하처럼 차가운 산 공기.";
"chap07_duncan_thesummit83" = "주홍빛 잎이 금빛 비처럼 우리 주위로 떨어진다.";
"chap07_duncan_thesummit84" = "두개골에서 뿔이 다시 자라나는 게 느껴진다.";
"chap07_duncan_thesummit85" = "그리고 공허.";
"chap07_duncan_thesummit86" = "나는 시간의 여명으로 내던져진다.";
"chap07_duncan_thesummit87" = "무엇이 기다리는지 안다.";
"chap07_duncan_thesummit88" = "인간이 아직 두 발로 걷지도 못하던 시대, 섬의 고독 속에서 견뎌야 할 끝없는 시간.";
"chap07_duncan_thesummit89" = "건설자들의 시대.";
"chap07_duncan_thesummit90" = "그들을 섬에서 지워 버린 마법의 대재앙.";
"chap07_duncan_thesummit91" = "마본과 사윈의 폭풍이 몰고 온 바람과 눈, 억수 같은 비에 휩쓸리는 선돌들.";
"chap07_duncan_thesummit92" = "생명나무를 지키기 위해 영적 세계에서 내려오는 수호자 예언자들.";
"chap07_duncan_thesummit93" = "던컨에 대한 기억에 매달린다.";
"chap07_duncan_thesummit94" = "잊어서는 안 된다. 이번만큼은.";
"chap07_duncan_thesummit95" = "황야가 보랏빛 꽃으로 뒤덮이는 모습을 보았다.";
"chap07_duncan_thesummit96" = "리타가 되면 풀은 누렇게 물들었다.";
"chap07_duncan_thesummit97" = "백 년 묵은 참나무의 잎이 붉어지고 떨어져, 이끼 낀 숲 바닥을 주황빛 갈색 부엽토로 덮었다.";
"chap07_duncan_thesummit98" = "율의 첫눈…";
"chap07_duncan_thesummit99" = "살아 있는 영혼은 하나도 없었다.";
"chap07_duncan_thesummit100" = "나는 그들이 돌아오기를 끈기 있게 기다렸다.";
"chap07_duncan_thesummit101" = "그리고 그들이 왔다…";
"chap07_duncan_thesummit102" = "…하지만 이번에는 맞이할 준비가 되어 있었다.";
"chap07_duncan_thesummit103" = "이번에는 그들을 잊지 않았다.";
//-> Stage: "chap07_duncan_timeknot"


/*** Chapter 7 — Duncan — Time Knot ***/
"chap07_duncan_timeknot01" = "그들은 해변에 상륙해 황야로 들어갔다.";
"chap07_duncan_timeknot02" = "던컨이 다시 대열 선두에 섰다…";
"chap07_duncan_timeknot03" = "하지만 그의 태도에는 전과 다른 무언가가 있다.";
"chap07_duncan_timeknot04" = "다가갈 때를 기다리며 멀찍이서 그들을 따른다.";
"chap07_duncan_timeknot05" = "몇 번이나 던컨이 마치 나를 보는 듯 지켜보고 있다는 느낌이 든다.";
"chap07_duncan_timeknot06" = "날이 어두워지자 크롬렉 근처에서 밤을 보내기로 한다.";
"chap07_duncan_timeknot07" = "이번에는 던컨이 앉은 채 불만 바라본다.";
"chap07_duncan_timeknot08" = "다른 이들이 잠든 것을 확인한 던컨은 자리에서 일어나, 멀리서 지켜보던 내 쪽으로 걸어온다.";
"chap07_duncan_timeknot09" = "로완?";
"chap07_duncan_timeknot10" = "내가 보여?"; 
"chap07_duncan_timeknot11" = "응.";
"chap07_duncan_timeknot12" = "그리고 기억나?";
"chap07_duncan_timeknot13" = "던컨이 생각에 잠겨 고개를 숙인다.";
"chap07_duncan_timeknot14" = "이 일은 이미 한 번 일어났던 거지?";
"chap07_duncan_timeknot15" = "이 섬에 발을 디딘 뒤로 계속 기시감이 들었어…";
"chap07_duncan_timeknot16" = "그 싸움이 기억나…";
"chap07_duncan_timeknot17" = "그리고 나무도…";
"chap07_duncan_timeknot18" = "잎이 불꽃 같은 나무?";
"chap07_duncan_timeknot19" = "너도 기억나…";
"chap07_duncan_timeknot20" = "기묘한 글자가 새겨진 동굴…";
"chap07_duncan_timeknot21" = "던컨이 내 눈을 깊이 들여다본다.";
"chap07_duncan_timeknot22" = "난 여기서 죽게 되어 있는 거지?";

"chap07_duncan_timeknot23_choice01_option" = "그래. 하지만 내가 막을 거야.";
"chap07_duncan_timeknot23_choice01_01" = "그를 속일 수는 없다.";
"chap07_duncan_timeknot23_choice01_02" = "그래…";
"chap07_duncan_timeknot23_choice01_03" = "던컨이 체념한 표정을 짓는다.";
"chap07_duncan_timeknot23_choice01_04" = "그를 품에 안고 위로하고 싶지만…";
"chap07_duncan_timeknot23_choice01_05" = "…나는 물질 세계에 손을 댈 수 없다.";
"chap07_duncan_timeknot23_choice01_06" = "적어도 정상에서 이렇게 멀리 떨어진 곳에서는.";
"chap07_duncan_timeknot23_choice01_07" = "내가 막을 거야.";
"chap07_duncan_timeknot23_choice01_08" = "약속해.";

"chap07_duncan_timeknot23_choice02_option" = "아니.";
"chap07_duncan_timeknot23_choice02_01" = "아니.";
"chap07_duncan_timeknot23_choice02_02" = "이 섬에서 죽어 마땅한 사람은 아무도 없어.";
"chap07_duncan_timeknot23_choice02_03" = "내가 막을 거야!";
"chap07_duncan_timeknot23_choice02_04" = "내가… 널 지킬게…";
"chap07_duncan_timeknot23_choice02_05" = "그를 품에 안고 위로하고 싶지만…";
"chap07_duncan_timeknot23_choice02_06" = "…나는 물질 세계에 손을 댈 수 없다.";
"chap07_duncan_timeknot23_choice02_07" = "적어도 정상에서 이렇게 멀리 떨어진 곳에서는.";
"chap07_duncan_timeknot23_choice02_08" = "던컨이 슬픈 눈으로 나를 바라본다.";

"chap07_duncan_timeknot24" = "로완…";
"chap07_duncan_timeknot25" = "내 운명이 이곳에서 죽는 거라면…";
"chap07_duncan_timeknot26" = "그 운명을 받아들이게 해 줘.";
"chap07_duncan_timeknot27" = "부탁이야, 약속해 줘.";
"chap07_duncan_timeknot28" = "주먹을 꽉 쥔다.";
"chap07_duncan_timeknot29" = "등 뒤 크롬렉에서 비친 빛이 우리 말을 끊는다.";
"chap07_duncan_timeknot30" = "던컨… 숨어야 해…";
"chap07_duncan_timeknot31" = "예언자들이…";
"chap07_duncan_timeknot32" = "던컨이 시선을 돌린다.";
"chap07_duncan_timeknot33" = "알겠어.";
"chap07_duncan_timeknot34" = "내 말을 생각해 봐.";
"chap07_duncan_timeknot35" = "해변으로 돌아간다.";
"chap07_duncan_timeknot36" = "다음 날, 제니버는 사라졌다.";
"chap07_duncan_timeknot37" = "일행은 숲으로 들어간다.";
"chap07_duncan_timeknot38" = "대열 앞쪽에서 말다툼이 벌어진다.";
"chap07_duncan_timeknot39" = "던컨이 공터로 들어선다.";
"chap07_duncan_timeknot40" = "코너를 지킨다.";
"chap07_duncan_timeknot41" = "에릭이 그에게 결투를 건다.";
"chap07_duncan_timeknot42" = "두 사람이 공격을 주고받는다.";
"chap07_duncan_timeknot43" = "던컨이 땅에 쓰러진다.";
"chap07_duncan_timeknot44" = "에릭이 그를 죽이려 검을 치켜든다.";
"chap07_duncan_timeknot45" = "던컨은 고개를 돌려 개입하지 말라는 뜻을 눈빛으로 전한다.";
"chap07_duncan_timeknot46" = "그를 구하려면 움직여야 한다.";

"chap07_duncan_timeknot47_choice01_option" = "던컨을 구한다.";
"chap07_duncan_timeknot47_choice01_01" = "이런 결말을 받아들일 수 없다.";
"chap07_duncan_timeknot47_choice01_02" = "던컨의 손을 붙잡아 그의 검을 에릭의 가슴에 찔러 넣는다.";
"chap07_duncan_timeknot47_choice01_03" = "전사는 충격에 찬 비명을 내지른 뒤 공터 바닥에 무릎을 꿇는다.";
//-> Stage: "chap07_duncan_rowandies"

"chap07_duncan_timeknot47_choice02_option" = "개입하지 않는다.";
"chap07_duncan_timeknot47_choice02_01" = "던컨의 뜻을 존중하기로 한다.";
"chap07_duncan_timeknot47_choice02_02" = "에릭의 검이 도끼날처럼 떨어지는 순간 고개를 돌린다.";
"chap07_duncan_timeknot47_choice02_03" = "뒤도 돌아보지 않고 숲으로 달아난다.";
