"chap04_duncantrial66_choice01_06" = "어쨌든 네가 그 재앙을 막기 위해 할 수 있었던 일은 많지 않았을 거다.";

"chap04_duncantrial66_choice02_option" = "내가 그곳에 있었어야 해…"; //Prometheus
