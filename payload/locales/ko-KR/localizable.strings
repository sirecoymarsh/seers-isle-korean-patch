/*** Chapter 4 — Duncan Trial / POV: Duncan ***/

"chap04_duncantrial01" = "나는 코너와 함께 남기보다 그를 따라가기로 한다.";
"chap04_duncantrial02" = "던컨과 나를 잇는 유대가 너무 강해 외면할 수 없다.";
"chap04_duncantrial03" = "던컨이 나무 사이를 서둘러 가는 동안 안개가 피어오르고 점점 짙어지는 듯하다.";
"chap04_duncantrial04" = "던컨이 망설인다.";
"chap04_duncantrial05" = "프레이야를 찾아 숲 너무 깊숙이 들어가면 야영지로 돌아가는 길을 찾지 못할지도 모른다.";
"chap04_duncantrial06" = "그는 자신에게 그녀만큼 뛰어난 방향 감각도, 흔적을 쫓는 재능도 없다는 것을 안다.";
"chap04_duncantrial07" = "한편 알린은 강만 따라가면 적어도 이론상으로는 야영지로 돌아갈 수 있다고 그는 생각한다.";

"chap04_duncantrial08" = "그는 프레이야가 남긴 흔적을 최대한 따라가며 계속 나아가기로 한다.";
"chap04_duncantrial09" = "흔적은 금세 종잡을 수 없게 된다.";
"chap04_duncantrial10" = "부드러운 흙 위의 발자국은 서로 엇갈린 방향을 가리키다가 완전히 사라진다.";
"chap04_duncantrial11" = "되돌아가려던 순간, 이상하리만치 낯익은 길에 닿는다.";
"chap04_duncantrial12" = "어떻게 이럴 수 있지?";
"chap04_duncantrial13" = "심장이 세차게 뛰는 가운데 앞으로 나아간다. 처음에는 걸음을 재촉하지만, 이내 기운이 빠져 속도가 느려진다.";
"chap04_duncantrial14" = "해가 자취를 감췄다.";
"chap04_duncantrial15" = "회색빛 하늘을 가린 가지 사이로 더는 햇살이 스며들지 않는다."; 
"chap04_duncantrial16" = "숲 가장자리에 다가갈수록 나무가 성기고, 소나무와 가문비나무 대신 고향의 너도밤나무와 서어나무가 모습을 드러낸다.";
"chap04_duncantrial17" = "땅 위에는 얇게 눈이 덮여 있다.";
"chap04_duncantrial18" = "뼛속까지 파고드는 매서운 추위가 던컨을 휘감는다.";
"chap04_duncantrial19" = "멀리 숲 가장자리, 성으로 이어지는 비탈 바로 앞에 두건을 쓴 형체가 그를 마주 보고 서 있다.";
"chap04_duncantrial20" = "왼손에 든 길고 울퉁불퉁한 지팡이. 수많은 옹이로 비틀리고 일그러진 그 모습은 단번에 알아볼 수 있다.";
"chap04_duncantrial21" = "그러나 노인의 자세에는 어딘가 낯설고 이상한 점이 있다.";
"chap04_duncantrial22" = "리스 삼촌?"; //Duncan
"chap04_duncantrial23" = "굶주림에 볼은 푹 패였고 두 눈은 열병에 들뜬 듯하다.";
"chap04_duncantrial24" = "며칠 전 섬으로 떠날 때 두고 온, 나이에도 불구하고 건장하며 늘 웃고 든든하게 곁을 지켜 주던 조언자의 모습이 아니다.";
"chap04_duncantrial25" = "그가 퀭한 눈으로 던컨을 바라본다.";
"chap04_duncantrial26" = "던컨?"; //Leith
"chap04_duncantrial27" = "너무 늦었구나… 너무나도 늦었어.";
"chap04_duncantrial28" = "네 아버지는 루나사드까지 너를 기다렸지… 그러다 인내심을 잃었다.";
"chap04_duncantrial29" = "무슨 일이 있었던 거예요?";
"chap04_duncantrial30" = "여름 동안 사슴 부족과 소규모 충돌이 있었어.";
"chap04_duncantrial31" = "내가 약초를 캐던 중에 놈들이 기습했다.";
"chap04_duncantrial32" = "날 인질로 잡았지… 아주… 오랫동안.";
"chap04_duncantrial33" = "리스가 고통스러운 표정을 짓는다. 그의 눈에서 죽음의 그림자가 언뜻 보인다.";
"chap04_duncantrial34" = "그리고 네 아버지는… 내면의 악마를 억눌러 줄 사람이 아무도 없자…";
"chap04_duncantrial35" = "리스는 입을 다문다. 두 사람 모두 더 말할 필요가 없음을 안다.";
"chap04_duncantrial36" = "네가 실패하지만 않았더라면…";

"chap04_duncantrial37_choice01_option" = "난 실패하지 않았어!"; //Gaia
"chap04_duncantrial37_choice01_01" = "하지만 난 실패하지 않았어요!";
"chap04_duncantrial37_choice01_02" = "그런 일은 일어나지 않았어요!";
"chap04_duncantrial37_choice01_03" = "난 모든 시험을 통과했고… 지금 정상으로 가는 중이에요!";
"chap04_duncantrial37_choice01_04" = "실패하지 않았다고?";
"chap04_duncantrial37_choice01_05" = "실패하지 않았다고! 정말로?!";
"chap04_duncantrial37_choice01_06" = "네가 떠난 지 여섯 달이 지났다.";
"chap04_duncantrial37_choice01_07" = "주위를 봐라. 겨울이 돌아왔잖느냐!";
"chap04_duncantrial37_choice01_08" = "아니에요, 아직 일어나지 않은 일이에요!";
"chap04_duncantrial37_choice01_09" = "난 성공할 거예요. 그리고 정말 이런 재앙이 닥친다면 부족을 도우러 돌아올 거예요.";
"chap04_duncantrial37_choice01_10" = "리스는 던컨의 말을 이해하지 못한 듯 혼란에 사로잡힌 눈으로 그를 바라본다.";

"chap04_duncantrial37_choice02_option" = "미안해요…"; //Prometheus
"chap04_duncantrial37_choice02_01" = "미안해요.";
"chap04_duncantrial37_choice02_02" = "리스가 연민 어린 눈으로 그를 바라본다.";
"chap04_duncantrial37_choice02_03" = "그래, 미안하긴 하겠지.";
"chap04_duncantrial37_choice02_04" = "실망할 기력조차 없구나…";
"chap04_duncantrial37_choice02_05" = "난 늘 네 편을 들었어. 알고 있지?";
"chap04_duncantrial37_choice02_06" = "알아요…";
"chap04_duncantrial37_choice02_07" = "네 어머니와 나는… 네가 우리 쪽 집안을 닮았다는 걸 금세 알아챘지…";
"chap04_duncantrial37_choice02_08" = "네 아버지가 결코 너를 형들 같은 전사로 만들 수 없으리라는 것도.";
"chap04_duncantrial37_choice02_09" = "모르겠구나… 언젠가 네가 부족에서 내 자리를 이어 네 아버지 곁에 서 주길 바랐어.";
"chap04_duncantrial37_choice02_10" = "난 늘 여신께서 내게 주지 않은 아들로 너를 여겼다.";
"chap04_duncantrial37_choice02_11" = "내가 틀렸어.";
"chap04_duncantrial37_choice02_12" = "던컨이 뉘우치는 마음으로 바닥을 응시한다.";

"chap04_duncantrial38" = "정확히 무슨 일이 있었던 거예요, 리스 삼촌?";
"chap04_duncantrial39" = "리타에 부족 회의가 열렸어.";
"chap04_duncantrial40" = "네 아버지는 봄에 약탈당한 농장의 책임을 물어 사슴 부족장인 늙은 하랄드에게 대가를 치르라 요구했지.";
"chap04_duncantrial41" = "나는 정면으로 몰아붙이지 말라고 경고했어. 하랄드는 사실을 부인할 거라고.";
"chap04_duncantrial42" = "더구나 우리에게는 책임을 물을 증거도 없었지.";
"chap04_duncantrial43" = "곧 분위기가 험악해졌다.";
"chap04_duncantrial44" = "하지만… 어느 회의에서나 있는 일이잖아요. 그래도 부족들은 늘 합의에 이르렀고요."; //Duncan
"chap04_duncantrial45" = "이번에는 아니었어…";
"chap04_duncantrial46" = "호수의 부족들이 하랄드 편에 섰지.";
"chap04_duncantrial47" = "교묘하게 짜 놓은 함정이었어.";
"chap04_duncantrial48" = "네 아버지는 분노에 휩싸여 늙은 하랄드의 머리에 도끼를 박아 넣었다.";
"chap04_duncantrial49" = "그의 아들은 젊은 미친개 같은 놈이라, 복수할 생각뿐이야.";

"chap04_duncantrial50" = "제가 그곳에 있었어야 했어요. 그랬다면…"; //Duncan
"chap04_duncantrial51" = "…뭔가 할 수 있었을 텐데.";

"chap04_duncantrial52" = "네가 할 수 있는 일은 아무것도 없었을 거다…";
"chap04_duncantrial53" = "여름 내내 다툼이 이어졌다.";
"chap04_duncantrial54" = "네 형 올라프는 호숫가에서 사냥하던 중 습격을 받아 다쳤고.";
"chap04_duncantrial55" = "난 그를 살릴 약초를 찾으러 갔다가 붙잡혔지.";
"chap04_duncantrial56" = "가을이 되자 전투가 격렬해졌다.";
"chap04_duncantrial57" = "네 아버지는 사슴 부족의 요새를 공격해 빼앗았다.";
"chap04_duncantrial58" = "하지만 늘 그렇듯, 치러야 할 대가는 생각하지 않았어.";
"chap04_duncantrial59" = "별들이 예고한 대로 수확은 이미 흉작이었는데, 충돌로 그마저도 망쳐 버렸다.";
"chap04_duncantrial60" = "기근이 닥쳤다. 우리 부족은 굶주렸어.";
