"chap05_rowanchildhood51_choice01_02" = "피오나의 얼굴이 환해진다.";
"chap05_rowanchildhood51_choice01_03" = "봐, 로완도 괜찮다고 하잖아!";
"chap05_rowanchildhood51_choice01_04" = "안 돼, 미안해. 아버지가 얘를 데려간 걸 아시면 나만 실컷 맞을 거야.";

"chap05_rowanchildhood51_choice02_option" = "피오나는 마을로 돌아가야 해."; //gaia
"chap05_rowanchildhood51_choice02_01" = "네 오빠 말이 맞아. 넌 우리와 같이 가기에는 너무 어리잖아.";
