/*** Chapter 2 — Bivouac / POV: Connor ***/

"chap02_bivouac01" = "일행에게 밤이 찾아온다."; //Image feu de camp, focus sur Connor
"chap02_bivouac02" = "황야에서는 마른 장작을 넉넉히 구할 수 없어, 알린과 던컨은 오래된 모닥불 흔적 위에 작은 불을 피운다.";
"chap02_bivouac03" = "아마 이전 원정대가 남긴 흔적일 것이다.";
"chap02_bivouac04" = "코너가 지친 다리를 쭉 뻗는다.";
"chap02_bivouac05" = "제대로 별빛 아래에서 잠드는 건 이번이 처음이다.";
"chap02_bivouac06" = "물론 신전이 거두기 전에는 현관 처마 밑이나 골목에서 자기도 했지만…";
"chap02_bivouac07" = "…보석을 박은 구체처럼 별이 가득한 하늘이 지평선 끝에서 끝까지 펼쳐진 이런 곳에서 자 본 적은 없다.";
"chap02_bivouac08" = "나머지 일행도 똑같이 지친 듯, 나누어 받은 빵과 치즈를 말없이 씹는다.";
"chap02_bivouac09" = "가져온 식량은 오래 버티지 못할 것이다. 서둘러 섬에서 먹을 것을 구해야 한다.";
"chap02_bivouac10" = "식사를 마친 알린이 가방에서 작은 나무 피리를 꺼낸다.";
"chap02_bivouac11" = "낮은 목소리로 이야기하거나 말없이 먹던 원정대원들은 손을 멈추고 악기에서 흘러나오는 애잔한 곡조에 귀를 기울인다.";
"chap02_bivouac12" = "순수하고 아이 같은 선율이다. 코너는 자장가나 동요가 아닐까 생각한다…";
"chap02_bivouac13" = "그런 곡은 한 번도 들어 본 적이 없다.";
"chap02_bivouac14" = "신전의 음악은 우렁차고 장엄하다…";
"chap02_bivouac15" = "도시의 선술집에서 들리던 춤곡들은…";
"chap02_bivouac16" = "알린의 피리에서 흘러나오는 애가처럼 부드럽고 그리운 음색은 분명 아니었다.";
"chap02_bivouac17" = "알린은 영적 황홀경에 빠진 듯 눈을 감고 연주한다.";
"chap02_bivouac18" = "마지막 음이 밤공기 속으로 흩어질 무렵, 알린은 모두가 말없이 자신을 바라보고 있다는 걸 깨닫는다.";
"chap02_bivouac19" = "알린의 얼굴이 붉어진다.";
"chap02_bivouac20" = "아, 미안해. 대화를 방해하려던 건 아니었어.";

"chap02_bivouac21_brandon" = "브랜던이 호기심 어린 눈으로 알린을 바라본다.";
"chap02_bivouac22_brandon" = "신기하네. 같은 지방 출신인데도 난 그 노래를 몰라.";
"chap02_bivouac23_brandon" = "어디서 배웠어?";

"chap02_bivouac21_notbrandon" = "아름다운 곡이네…"; //Freya
"chap02_bivouac22_notbrandon" = "네 고향에서 전해지는 선율이야?";

"chap02_bivouac22" = "아버지가 가르쳐 주셨어.";
"chap02_bivouac23" = "아버지는 남쪽 출신이라 네가 곡조를 모르는 것도 당연해.";
"chap02_bivouac24" = "아버지가 먼 길을 떠나 계실 때면 동생들에게 이 곡을 연주해 줘.";

"chap02_bivouac25_choice01_option" = "알린을 칭찬한다."; //Arlyn ++ 
"chap02_bivouac25_choice01_01" = "어쨌든 정말 잘 부는구나."; //Connor
"chap02_bivouac25_choice01_02" = "수도의 음유시인들과 견주어도 손색없어.";
"chap02_bivouac25_choice01_03" = "알린은 쑥스러운 듯 희미하게 미소 짓는다.";
"chap02_bivouac25_choice01_04" = "고마워."; //Arlyn

"chap02_bivouac25_choice02_option" = "아무 말도 하지 않는다."; //Arlyn -- 
"chap02_bivouac25_choice02_01" = "코너는 입을 다문다.";

"chap02_bivouac26" = "제니버가 미소 짓는다.";
"chap02_bivouac27" = "다른 곡도 연주해 줄래?";
"chap02_bivouac28" = "네 피리 소리는 마음을 편안하게 해. 그리고… 생각을 정리하는 데도 도움이 돼.";
"chap02_bivouac29" = "오늘 일어난 모든 일을 생각하면… 머릿속을 정리할 필요가 있어. 뭔가가…";
"chap02_bivouac30" = "제니버가 일행을 돌아본다.";
"chap02_bivouac31" = "잘 모르겠어. 무슨 말이 혀끝에서 맴도는데 도무지 떠오르지 않는 기분이야.";
"chap02_bivouac32" = "몇몇은 동의하고, 다른 이들은 놀란 눈으로 제니버를 바라본다.";
"chap02_bivouac33" = "에릭은 불을 등지고 누워, 기운을 비축하는 편이 낫다느니 피리 소리 때문에 잠들지 못할 정도는 아니라느니 투덜거린다…";
"chap02_bivouac34" = "알린이 다시 연주한다.";
"chap02_bivouac35" = "코너는 건성으로 음악을 듣다가 제니버가 기묘할 만큼 강렬한 눈빛으로 불길을 응시하고 있다는 걸 알아차린다.";
"chap02_bivouac36" = "일행은 오랫동안 알린의 매혹적이고 신비로운 피리 선율에 몸을 맡긴다.";
"chap02_bivouac37" = "그러다 알린이 눈을 뜨고 연주를 멈춘다.";
"chap02_bivouac38" = "제니버는 영문도 모르게 거세진 불길을 계속 응시한다.";
"chap02_bivouac39" = "제니버의 시선이 어둠 속, 텅 빈 황야로 향한다.";

//depending on max affinity :
"chap02_bivouac41_arlyn" = "그러고는 알린을 돌아본다."; 
"chap02_bivouac42_arlyn" = "밤에 들리는 속삭임을 경계해.";
"chap02_bivouac43_arlyn" = "정말 네 선택이 네 의지에서 나온 것이라고 확신해?";
"chap02_bivouac44_arlyn" = "알린은 어떻게 반응해야 할지 몰라 한다.";
"chap02_bivouac45_arlyn" = "제니버? 괜찮아?"; //Arlyn

"chap02_bivouac41_connor" = "그러고는 코너를 돌아본다."; 
"chap02_bivouac42_connor" = "밤에 들리는 속삭임을 경계해.";
"chap02_bivouac43_connor" = "정말 네 선택이 네 의지에서 나온 것이라고 확신해?";
"chap02_bivouac44_connor" = "코너는 어떻게 반응해야 할지 몰라 한다.";
