"chap04_duncantrial62" = "공성전 중에는 네 아버지가 총애하던 비욘손이 죽었고.";
"chap04_duncantrial63" = "이제 남은 건 너뿐이다.";
"chap04_duncantrial64" = "네가 마지막 후계자야.";

"chap04_duncantrial66_choice01_option" = "내 잘못이 아니야."; //Gaia
"chap04_duncantrial66_choice01_01" = "내 잘못이 아니에요.";
"chap04_duncantrial66_choice01_02" = "리스가 의심스러운 눈으로 던컨을 바라본다.";
"chap04_duncantrial66_choice01_03" = "이 섬의 예언자들이…";
"chap04_duncantrial66_choice01_04" = "시간을 늘려 놓았어요. 마법으로 저를 괴롭히고 있다고요.";
