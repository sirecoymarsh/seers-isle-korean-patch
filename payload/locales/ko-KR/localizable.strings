/*** Chapter 6 — Walk with Arlyn — Prometheus / Chaos ***/

"chap06_walkwitharlyn01" = "나는 알린 곁에 남기로 한다.";
"chap06_walkwitharlyn02" = "알린이 가방을 들어 어깨에 메는 것조차 힘겨워하는 모습을 보고 도와주겠다고 한다.";
"chap06_walkwitharlyn03" = "잠깐 가방을 들어 줄까, 알린?";
"chap06_walkwitharlyn04" = "아니, 괜찮아.";

"chap06_walkwitharlyn05_choice01_option" = "계속 권한다."; //Chaos / Arlyn Love++
"chap06_walkwitharlyn05_choice01_01" = "걷느라 완전히 지쳤잖아. 내가 도와줄게."; 
