"chap03_erikfight64" = "이번에는 던컨이 버티며 반격한다. 검끝으로 찌르지만 에릭은 옆으로 비켜 피한다.";
"chap03_erikfight65" = "두 사람은 몇 번이고 서로에게 검을 휘두른다.";
"chap03_erikfight66" = "에릭은 숨 하나 차지 않았지만 던컨은 빠르게 지쳐 간다.";
"chap03_erikfight67" = "내가 개입하지 않으면 결과는 뻔하다."; 
"chap03_erikfight68" = "에릭은 던컨을 죽이고 코너를 공격할 것이다.";
"chap03_erikfight69" = "프레이야가 끼어들면 아마 같은 운명을 맞을 것이다.";
"chap03_erikfight70" = "이 참극을 피하려면 내가 무언가 해야 한다.";

"chap03_erikfight71_choice01_option" = "프레이야에게 활을 쏘도록 강요한다."; //Freya++
"chap03_erikfight71_choice01_01" = "나는 프레이야의 뒤에 자리 잡고 활을 당기라고 명령한다.";
"chap03_erikfight71_choice01_02" = "프레이야는 순간 혼란스러워하지만, 곧 결연함이 그 혼란을 밀어낸다.";
"chap03_erikfight71_choice01_03" = "상처만으로는 에릭을 멈출 수 없음을 알기에, 프레이야는 그의 가슴을 곧장 겨눈다.";
"chap03_erikfight71_choice01_04" = "오히려 분노만 더 키울 뿐이다.";
"chap03_erikfight71_choice01_05" = "손이 흔들리지 않도록 천천히 숨을 내쉰다.";
"chap03_erikfight71_choice01_06" = "던컨은 지쳐 보인다. 더는 오래 버티지 못할 것이다.";
"chap03_erikfight71_choice01_07" = "에릭의 강력한 일격에 던컨이 균형을 잃는다.";
"chap03_erikfight71_choice01_08" = "에릭은 틈을 놓치지 않고 마지막 일격을 날리려 한다.";
"chap03_erikfight71_choice01_09" = "프레이야는 기회를 포착한다.";
"chap03_erikfight71_choice01_10" = "에릭이 검을 하늘 높이 치켜드는 순간, 화살이 날아간다.";
"chap03_erikfight71_choice01_11" = "화살은 빠르고 우아하게 허공을 가른다.";
"chap03_erikfight71_choice01_12" = "내가 조금 거들었을 뿐인데, 프레이야는 던컨의 목숨을 구했다.";
"chap03_erikfight71_choice01_13" = "나는 프레이야 특유의 단순명쾌함이 마음에 든다.";
"chap03_erikfight71_choice01_14" = "시간이 잠시 멈춘 듯하다.";
"chap03_erikfight71_choice01_15" = "이내 화살이 에릭의 심장에 정확히 박힌다.";
"chap03_erikfight71_choice01_16" = "에릭은 놀란 나머지 검을 땅에 떨어뜨린다.";
"chap03_erikfight71_choice01_17" = "던컨이 뒤로 몸을 날려 거대한 전사의 사정거리에서 벗어난다.";
"chap03_erikfight71_choice01_18" = "에릭이 믿을 수 없다는 듯 자신의 가슴을 내려다본다.";
"chap03_erikfight71_choice01_19" = "마치 처음으로 패배할 수도 있다는 생각이 머리를 스친 듯하다.";
