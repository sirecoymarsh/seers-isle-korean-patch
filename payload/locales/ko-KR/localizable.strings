"chap06_bivouacduncan08" = "던컨이 조금 더 앞쪽 길가의 불빛을 가리킨다.";
"chap06_bivouacduncan09" = "땅거미가 진 가운데 희미하게 흔들리는 빛이 보인다.";
"chap06_bivouacduncan10" = "함정일지도 몰라?"; //Rowan
"chap06_bivouacduncan11" = "함정이라 해도 어쩔 수 없어. 다른 선택은 없는 것 같아, 로완.";
"chap06_bivouacduncan12" = "나는 고개를 끄덕인다.";
"chap06_bivouacduncan13" = "네 말이 맞아.";
"chap06_bivouacduncan14" = "던컨이 마지막 힘을 짜내 걸음을 재촉한다.";
"chap06_bivouacduncan15" = "나는 몇 걸음 뒤에서 따라간다.";
"chap06_bivouacduncan16" = "빛은 바위가 움푹 들어간 작은 공간에서 흘러나온다.";
"chap06_bivouacduncan17" = "던컨이 안도한 표정으로 돌아서서 내게 다가오라고 손짓한다.";
"chap06_bivouacduncan18" = "작은 동굴에는 사람은 없고 방금 피운 모닥불만 타오르고 있다.";
"chap06_bivouacduncan19" = "천장에는 연기가 빠져나갈 구멍이 있다.";
"chap06_bivouacduncan20" = "벽면에는 서로 얽힌 곡선과 고대의 기호가 새겨져 있지만, 그 의미는 영원히 시간 속에 묻혔다.";
"chap06_bivouacduncan21" = "거석을 세운 장인들의 피난처였던 모양이다.";
"chap06_bivouacduncan22" = "불 옆에는 과일 바구니와 따뜻한 옷가지 더미, 담요 몇 장이 놓여 있다.";
"chap06_bivouacduncan23" = "동굴 구석에는 불을 지필 마른 장작까지 쌓여 있다.";

"chap06_bivouacduncan24_choice01_option" = "알린이 준비한 것 같아?";
"chap06_bivouacduncan24_choice01_01" = "알린이 준비한 걸까…";
"chap06_bivouacduncan24_choice01_02" = "던컨이 고개를 젓는다.";
"chap06_bivouacduncan24_choice01_03" = "알린의 가방에는 따뜻한 옷도, 싱싱한 과일 한 바구니도 들어 있지 않아.";
"chap06_bivouacduncan24_choice01_04" = "알린이 불을 피웠다면 분명 아직 여기서 몸을 녹이고 있었겠지.";
"chap06_bivouacduncan24_choice01_05" = "아니야, 로완. 놀랍게도 예언자들이 마침내 우리를 돕기로 한 것 같아.";

"chap06_bivouacduncan24_choice02_option" = "예언자들이 준비한 것 같아?";
"chap06_bivouacduncan24_choice02_01" = "예언자들이 준비한 걸까…";
"chap06_bivouacduncan24_choice02_02" = "던컨이 고개를 끄덕인다.";
"chap06_bivouacduncan24_choice02_03" = "그럼 누구겠어?";
"chap06_bivouacduncan24_choice02_04" = "알린이 불을 피웠다면 정말 멀리 떠났을 것 같아?";
"chap06_bivouacduncan24_choice02_05" = "네 말이 맞아. 어쨌든 알린의 가방에는 따뜻한 옷도, 싱싱한 과일 한 바구니도 들어 있지 않아."; //Rowan
"chap06_bivouacduncan24_choice02_06" = "놀랍게도 예언자들이 마침내 우리를 돕기로 한 것 같아."; //Rowan

"chap06_bivouacduncan25" = "던컨은 장작 두 개를 불에 넣고 앉는다.";
"chap06_bivouacduncan26" = "어쨌든 너무 지쳐서 이 선물을 의심할 기운도 없어.";
"chap06_bivouacduncan27" = "나도 던컨 곁에 앉는다.";
"chap06_bivouacduncan28" = "딱히 춥지는 않지만 불의 은은한 온기가 피부에 닿는 느낌은 기분 좋다.";
"chap06_bivouacduncan29" = "던컨은 과일 바구니를 집어 사과를 한 입 베어 문다.";
"chap06_bivouacduncan30" = "맛있는 사냥감 고기는 아니지만 오늘 밤은 이걸로 충분해.";
"chap06_bivouacduncan31" = "던컨이 내게 과일을 권한다.";
"chap06_bivouacduncan32" = "배고파?";
"chap06_bivouacduncan33" = "놀랍게도 몹시 허기진 상태라는 걸 깨닫는다.";
"chap06_bivouacduncan34" = "철이 아닌데도 내가 가장 좋아하는 과일인 무화과가 몇 개 있다.";
"chap06_bivouacduncan35" = "무화과 하나를 조심스럽게 벌려 달콤하고 붉은 과육을 베어 문다.";
"chap06_bivouacduncan36" = "네가 음식을 먹을 수 있는지 확신이 없었어…"; //Duncan
"chap06_bivouacduncan37" = "나도 그랬어. 하지만 오랫동안 배고픔도 갈증도 느끼지 못한 뒤라 얼마나 좋은지 상상도 못 할 거야.";
"chap06_bivouacduncan38" = "던컨은 묘하게 강렬한 눈빛으로 나를 바라본다.";

"chap06_bivouacduncan39_choice01_option" = "던컨에게 입을 맞춘다.";
"chap06_bivouacduncan39_choice01_01" = "나는 던컨의 손 위에 내 손을 포갠다.";
"chap06_bivouacduncan39_choice01_02" = "던컨이 내 팔을 잡아 자신에게로 끌어당긴다.";
"chap06_bivouacduncan39_choice01_03" = "우리는 잠시 서로의 눈을 바라본다.";
"chap06_bivouacduncan39_choice01_04" = "긴장을 더 견딜 수 없게 되자 마침내 던컨이 내 턱을 감싸 쥐고 수줍게 입을 맞춘다.";
"chap06_bivouacduncan39_choice01_05" = "나도 입맞춤에 화답하고, 늦은 밤까지 불의 온기 속에서 단둘이 서로를 끌어안는다.";
"chap06_bivouacduncan39_choice01_06" = "던컨이 먼저 잠들고, 나는 곁에 누워 동굴 벽 위에서 춤추는 불빛을 바라본다.";
"chap06_bivouacduncan39_choice01_07" = "나도 모르는 사이 던컨에게 바싹 기대어 꿈도 없는 잠에 빠진다.";

"chap06_bivouacduncan39_choice02_option" = "혼자 잠자리에 든다.";
"chap06_bivouacduncan39_choice02_01" = "나는 조금 당황해 시선을 피한다.";
"chap06_bivouacduncan39_choice02_02" = "던컨, 이제 늦었으니 좀 쉬어야겠어.";
"chap06_bivouacduncan39_choice02_03" = "나는 던컨의 맞은편, 모닥불 건너편에 자리를 마련한다.";
"chap06_bivouacduncan39_choice02_04" = "던컨이 실망한 표정으로 시선을 돌린다.";
"chap06_bivouacduncan39_choice02_05" = "그래, 네 말이 맞아.";
"chap06_bivouacduncan39_choice02_06" = "던컨은 담요를 가져다가 몸을 둘둘 감싼다.";
"chap06_bivouacduncan39_choice02_07" = "나도 똑같이 하고 누워서 동굴 벽 위에서 춤추는 불빛을 오랫동안 바라본다.";
"chap06_bivouacduncan39_choice02_08" = "나도 모르는 사이 마침내 꿈도 없는 잠에 빠진다.";

"chap06_bivouacduncan40" = "동굴 입구로 스며든 창백한 새벽빛에 잠에서 깬다.";
"chap06_bivouacduncan41" = "불은 잉걸불 몇 조각만 남기고 거의 다 타 버렸다.";
"chap06_bivouacduncan42" = "내 몸에 한기가 흐른다.";
"chap06_bivouacduncan43" = "던컨이 기지개를 켜고 일어선다.";
"chap06_bivouacduncan44" = "아직 잠이 덜 깬 던컨은 장작 더미에서 나무를 꺼내 화덕에 던지고 막대기로 뒤적여 불씨를 되살린다.";
"chap06_bivouacduncan45" = "던컨은 나를 돌아보다가 깜짝 놀라 막대기를 떨어뜨린다.";
"chap06_bivouacduncan46" = "로완?!";
"chap06_bivouacduncan47" = "응?";
"chap06_bivouacduncan48" = "네 뿔이… 사라졌어.";
"chap06_bivouacduncan49" = "던컨의 말이 사실임을 느끼면서도 확인하려고 이마를 손으로 쓸어 본다.";
"chap06_bivouacduncan50" = "뿔이 있던 자리에는 작은 돌기 두 개만 남았고, 머리카락으로 가릴 수 있을 듯하다.";
"chap06_bivouacduncan51" = "그럼 다시 인간이 된 거야?"; 
"chap06_bivouacduncan52" = "나는 어깨를 으쓱한다.";
"chap06_bivouacduncan53" = "모르겠어. 입구에서 들어오는 한기와 불에서 나오는 온기가 조금은 느껴지지만, 원래 느껴야 할 만큼 강하지는 않아.";
"chap06_bivouacduncan54" = "곧 확실히 알게 되겠지."; //Duncan
"chap06_bivouacduncan55" = "정상까지 거의 다 왔어. 꾸물거리지 않으면 해가 지기 전에 도착할 수 있을 거야.";
"chap06_bivouacduncan56" = "길어도 반나절이면 도착해."; //Rowan
"chap06_bivouacduncan57" = "기운을 차리고 출발하자."; //Rowan
"chap06_bivouacduncan58" = "나는 과일 바구니를 가져다가 던컨에게 건넨다.";
"chap06_bivouacduncan59" = "우리는 말없이 아침을 먹는다.";
"chap06_bivouacduncan60" = "던컨은 습관처럼 남은 불씨와 재를 흩어 놓고, 나는 담요를 갠다.";
"chap06_bivouacduncan61" = "알린도 정상으로 가는 중이기를 희미하게 바라며 과일이 남은 바구니를 입구 근처의 잘 보이는 곳에 둔다.";
"chap06_bivouacduncan62" = "던컨이 그 모습을 알아차린다.";
"chap06_bivouacduncan63" = "던컨은 아무 말도 하지 않지만 슬픔이 밴 다정한 눈빛만으로 마음을 드러낸다.";
"chap06_bivouacduncan64" = "우리는 출발한다.";
"chap06_bivouacduncan65" = "던컨은 우리를 위해 남겨 둔 물건 중 거무스름한 짐승 가죽을 챙겨 어깨에 걸치고 있다.";
"chap06_bivouacduncan66" = "우리는 오랫동안 말없이 걷는다.";
"chap06_bivouacduncan67" = "산의 창백한 햇빛이 무지갯빛으로 반짝이는 호수 수면에 비친다.";
"chap06_bivouacduncan68" = "주위는 거의 완전한 침묵에 잠겨 있어, 신성한 장소를 더럽히러 온 침입자가 된 듯한 불쾌한 기분이 든다.";
"chap06_bivouacduncan69" = "길은 거석에서 다음 거석으로 이어져 맞은편 물가에 닿고, 그곳에서 정상 쪽으로 갈라져 비탈을 따라 구불구불 올라간다.";
"chap06_bivouacduncan70" = "던컨이 숨을 고르려고 멈춘다.";
"chap06_bivouacduncan71" = "던컨이 내게 물통을 내민다. 우리는 몇 모금씩 마시고, 던컨은 물가에 쪼그려 앉아 물통을 다시 채운다.";
"chap06_bivouacduncan72" = "어제저녁에는 간신히 보이던 산 위의 붉은 자국이 이제는 선명하다.";
"chap06_bivouacduncan73" = "저 위에 있는 게 뭔지 알아?";
"chap06_bivouacduncan74" = "정상에 보이는 저 붉은 부분?";
"chap06_bivouacduncan75" = "불꽃나무야.";
"chap06_bivouacduncan76" = "불꽃나무?";
"chap06_bivouacduncan77" = "나는 동굴에서 본 환영을 최대한 떠올리려고 시선을 내린다.";
"chap06_bivouacduncan78" = "예언자들의 세계로 통하는 문이자 그들 마법의 근원이야.";
"chap06_bivouacduncan79" = "우리 둘 다 그곳에 가야 한다는 건 알아.";
"chap06_bivouacduncan80" = "그다음에는 어떻게 되는 거야?";

"chap06_bivouacduncan81_choice01_option" = "예언자들을 설득해 나를 보내 달라고 해 볼 거야.";
"chap06_bivouacduncan81_choice01_01" = "나는 한숨을 내쉰다.";
"chap06_bivouacduncan81_choice01_02" = "마침내 이곳을 떠날 수 있도록 예언자들을 설득하기 위해 할 수 있는 일은 전부 해 볼 거야.";

"chap06_bivouacduncan81_choice02_option" = "넌 주술사가 될 거야.";
"chap06_bivouacduncan81_choice02_01" = "넌 시련을 통과했어.";
"chap06_bivouacduncan81_choice02_02" = "우리는 등반을 마칠 거고, 넌 주술사가 되어 선조들의 땅으로 돌아가 부족의 길잡이가 될 거야.";

"chap06_bivouacduncan81_choice03_option" = "전혀 모르겠어.";
"chap06_bivouacduncan81_choice03_01" = "전혀 모르겠어.";
"chap06_bivouacduncan81_choice03_02" = "나는 눈을 내리깐다.";
"chap06_bivouacduncan81_choice03_03" = "우리에게 무슨 일이 일어날지는 모르지만 다른 선택은 없어…";


"chap06_bivouacduncan81_duncanlove" = "던컨이 나를 품에 안는다.";
"chap06_bivouacduncan82_duncanlove" = "우리는 서로 얽힌 채 주변 세계를 보지도 듣지도 못하고 오랫동안 그대로 서 있다.";
"chap06_bivouacduncan83_duncanlove" = "던컨도 나도 이 순간의 소박한 마법을 깨뜨리고 싶은 마음은 조금도 없다.";
"chap06_bivouacduncan84_duncanlove" = "던컨이 내게 속삭인다.";
"chap06_bivouacduncan85_duncanlove" = "너 없이는 떠나지 않을 거야.";

"chap06_bivouacduncan86_duncanlove_choice01_option" = "네 부족에는 네가 필요해.";
"chap06_bivouacduncan86_duncanlove_choice01_01" = "던컨, 네 부족에는 네가 필요해.";
"chap06_bivouacduncan86_duncanlove_choice01_02" = "알아…";
"chap06_bivouacduncan86_duncanlove_choice01_03" = "하지만 너를 잃으면 누구를 구할 힘도 남지 않을 거야.";

"chap06_bivouacduncan86_duncanlove_choice02_option" = "널 버리지 않을게.";
"chap06_bivouacduncan86_duncanlove_choice02_01" = "나도 너를 떠나고 싶지 않아.";
"chap06_bivouacduncan86_duncanlove_choice02_02" = "잘됐네…"; //Duncan
"chap06_bivouacduncan86_duncanlove_choice02_03" = "그렇다면 예언자들이 우리 말을 듣도록 설득하기만 하면 돼.";


"chap06_bivouacduncan81_notduncanlove" = "던컨이 내 어깨에 손을 얹는다.";
"chap06_bivouacduncan82_notduncanlove" = "로완, 널 돕기 위해 내가 할 수 있는 일은 무엇이든 하겠다고 약속할게.";
"chap06_bivouacduncan83_notduncanlove" = "던컨, 네 부족에는 네가 필요해.";
"chap06_bivouacduncan84_notduncanlove" = "나는 던컨의 손을 밀어 내고 등을 돌린 채 호수를 바라본다.";
"chap06_bivouacduncan85_notduncanlove" = "나 때문에 네 목숨을 걸게 할 수는 없어.";
"chap06_bivouacduncan86_notduncanlove" = "상처받은 던컨이 시선을 피한다.";
"chap06_bivouacduncan87_notduncanlove" = "알았어.";

"chap06_bivouacduncan88" = "우리는 정상을 향해 계속 나아간다.";
