"chap04_freyatrial46_choice02_option" = "프레이야가 싸운다."; //Prometheus
"chap04_freyatrial46_choice02_01_prometheus" = "프레이야가 활을 당겨 화살 한 발, 또 한 발을 쏜다.";
"chap04_freyatrial46_choice02_02_prometheus" = "화살이 짐승의 가죽을 파고든다…";
"chap04_freyatrial46_choice02_03_prometheus" = "짐승이 고통과 분노에 찬 울음을 내지르지만 멈추지 않는다.";
"chap04_freyatrial46_choice02_04_prometheus" = "나는 숨을 죽인다.";
"chap04_freyatrial46_choice02_05_prometheus" = "프레이야가 창을 잡으려고 몸을 돌리지만 짐승은 이미 덮칠 태세다.";
"chap04_freyatrial46_choice02_07_prometheus" = "짐승이 뒷다리로 일어선다.";
"chap04_freyatrial46_choice02_08_prometheus" = "프레이야는 매끄러운 동작으로 오른쪽 어깨를 짐승의 아가리에 내주고, 돌진하는 힘을 이용해 창을 짐승의 가슴 깊숙이 박는다.";
"chap04_freyatrial46_choice02_09_prometheus" = "그러고는 몸을 비틀어 창대를 동굴 바닥에 고정한다.";
"chap04_freyatrial46_choice02_10_prometheus" = "무기에 꿰인 짐승이 프레이야 위로 쓰러진다.";
"chap04_freyatrial46_choice02_11_prometheus" = "거대한 몸뚱이가 바닥에 처박힌다.";
//-> "chap04_freyatrial47_prometheus"

"chap04_freyatrial46_choice02_01_gaia" = "프레이야는 무기를 치켜들고 짐승에게 달려들려다 갑자기 멈춘다.";
//-> "chap04_freyatrial47_gaia"

"chap04_freyatrial47_prometheus" = "나는 터져 나오는 비명을 막지 못한다.";
"chap04_freyatrial48_prometheus" = "짐승의 신음과 낑낑거림이 점점 약해진다.";
"chap04_freyatrial49_prometheus" = "나는 망연자실한 채 동굴 구석 바닥에 주저앉는다.";
"chap04_freyatrial50_prometheus_order" = "프레이야가… 죽었다면… 어떻게 나 자신을 탓하지 않을 수 있을까? 여기까지 이끈 건 나다.";
"chap04_freyatrial50_prometheus_chaos" = "프레이야가… 죽었다면… 아까운 희생이야.";
"chap04_freyatrial51_prometheus" = "한참 뒤 괴물이 마지막 숨을 내쉬고 침묵이 동굴을 뒤덮는다.";
"chap04_freyatrial52_prometheus" = "나는 끔찍한 광경을 차마 바라보지 못한다.";
"chap04_freyatrial53_prometheus" = "이곳을 떠나려는 순간 무언가 소리가 난다.";
"chap04_freyatrial54_prometheus" = "시체가 들려 옆으로 밀리고 프레이야가 그 아래에서 기어 나온다.";
"chap04_freyatrial55_prometheus" = "오른쪽 팔은 축 늘어졌고 어깨에는 크고 피투성이인 상처가 있다.";
"chap04_freyatrial56_prometheus" = "프레이야가 나를 향해 몸을 돌리고 넋이 나간 표정으로 바라본다.";
"chap04_freyatrial57_prometheus" = "하지만… 넌 누구야?"; //Freya
"chap04_freyatrial58_prometheus" = "여기서 뭐 하는 거야?";

"chap04_freyatrial47_gaia" = "프레이야는 등 뒤 땅에 창을 꽂고 짐승을 안심시키려는 몸짓으로 손을 내민다.";
"chap04_freyatrial48_gaia" = "나는 숨을 죽인다.";
"chap04_freyatrial49_gaia" = "짐승이 조심스럽게 다가온다.";
"chap04_freyatrial50_gaia" = "프레이야는 평온한 얼굴로 땅을 내려다본다.";
"chap04_freyatrial51_gaia" = "이미 승산이 없을 게 분명한 싸움을 거부한다.";
"chap04_freyatrial52_gaia" = "마치 자신의 운명을 받아들인 듯하다.";
"chap04_freyatrial53_gaia" = "짐승의 주둥이가 프레이야의 얼굴에서 몇 센티미터 떨어진 곳까지 다가온다.";
"chap04_freyatrial54_gaia" = "프레이야는 흔들리지 않는다.";
"chap04_freyatrial55_gaia" = "공포에 몸이 굳었다 해도 겉으로 드러내지 않는다.";
"chap04_freyatrial56_gaia" = "짐승은 프레이야의 냄새를 맡고 뒤로 물러난다.";
"chap04_freyatrial57_gaia" = "멍하지만 슬픔에 찬 눈으로 프레이야를 바라본다.";
"chap04_freyatrial58_gaia" = "그러다 푸르스름한 연기 소용돌이로 변해 하늘로 올라가며 사라진다.";
"chap04_freyatrial59_gaia" = "프레이야가 나를 돌아본다.";
"chap04_freyatrial60_gaia" = "넌 누구야?";
"chap04_freyatrial61_gaia" = "여기서 뭐 하는 거야?";

"chap04_freyatrial62" = "내가 보여?";
"chap04_freyatrial63" = "프레이야가 의아한 표정으로 나를 바라본다.";
"chap04_freyatrial64" = "계속 우리를 따라온 거야? 거석부터… 아니, 해변부터?";
"chap04_freyatrial65" = "응.";
"chap04_freyatrial66" = "던컨과 코너, 알린도 위험에 빠졌을 거라는 걸 깨닫는다.";
"chap04_freyatrial67" = "설명할 시간이 없어.";
"chap04_freyatrial68" = "다른 사람들을 도와야 해.";
"chap04_freyatrial69" = "나도 같이 갈게!";
"chap04_freyatrial70" = "안 돼! 넌 도움이 될 수 없어.";
"chap04_freyatrial71" = "하지만…";
"chap04_freyatrial72" = "날 믿어야 해, 프레이야! 시간이 없어.";
"chap04_freyatrial73" = "동굴 반대편 출구에서 기다려.";
"chap04_freyatrial74" = "나는 몸을 돌려 동굴 입구를 향해 달린다.";
"chap04_freyatrial75" = "출구에 가까워질수록 인간의 세계에 나를 붙잡아 두던 힘이 다시 빠져나가는 것을 느낀다.";
"chap04_freyatrial76" = "다른 사람들에게 너무 늦지 않았기를 바란다.";
"chap04_freyatrial77" = "소나무 사이를 달리며 내가 다시 보이지 않게 되었다는 걸 안다.";
"chap04_freyatrial78" = "강바닥을 따라가며 알린을 찾기로 한다.";
"chap04_freyatrial79" = "하류로 한참 내려가다 포기한다. 알린의 흔적이 없다. 아마 너무 늦었을 것이다…";
"chap04_freyatrial80" = "야영지로 돌아가야 한다. 너무 지체하면 던컨과 코너에게도 늦고 말 것이다.";


/*** Chapter 4 — Arlyn Trial / POV: Arlyn ***/

"chap04_arlyntrial01" = "프레이야는 개울로 가서 쪼그려 앉아 물통을 채운다.";
"chap04_arlyntrial02" = "알린도 똑같이 물통을 채우고 프레이야에게 미소 지은 뒤, 강을 살피며 하류로 걸어간다.";
"chap04_arlyntrial03" = "수면 아래로 아마도 송어나 연어일 물고기가 수없이 헤엄치지만, 물살이 너무 세서 낚싯줄을 드리울 수 없다.";
"chap04_arlyntrial04" = "낚싯대를 만들 나뭇가지도 찾아야 한다…";
"chap04_arlyntrial05" = "…하지만 개울가를 둘러싼 나무가 침엽수뿐이라 생각보다 어려울지도 모른다…";
"chap04_arlyntrial06" = "갈대가 있으면 좋겠지만, 내륙 깊숙한 곳에서는 자라지 않는 모양이다.";
"chap04_arlyntrial07" = "알린이 이 난제를 고민하던 중 머리 위에서 가마우지 울음소리가 들린다.";
"chap04_arlyntrial08" = "가마우지라고? 이렇게 내륙 깊숙한 곳에?";

"chap04_arlyntrial09" = "알린은 손으로 햇빛을 가리고 새를 찾는다.";
"chap04_arlyntrial10" = "한순간 빛에 눈이 부신다.";
"chap04_arlyntrial11" = "눈이 빛에 적응하기도 전에 파도 소리가 귓가에 들려온다.";
"chap04_arlyntrial12" = "숲은 사라지고 짙은 안개가 사방을 뒤덮고 있다.";
"chap04_arlyntrial13" = "발밑에는 모래가, 코끝에는 짭조름한 바닷물 냄새가 느껴진다.";
"chap04_arlyntrial14" = "왼쪽으로 바다를 향해 뻗은 바위 곶이 어렴풋이 보인다.";
"chap04_arlyntrial15" = "알린은 이 작은 만을 안다.";
"chap04_arlyntrial16" = "동쪽의 오솔길을 올라가면 가족이 사는 작은 집이 나올 것이다.";
"chap04_arlyntrial17" = "알린의 몸에 전율이 흐른다.";
"chap04_arlyntrial18" = "분명 조금 전까지 있던 봄날의 날씨가 아니다.";
"chap04_arlyntrial19" = "알린은 절벽을 따라 난 길을 올라 헤더가 듬성듬성 자란 황량한 들판에 도착한다.";
"chap04_arlyntrial20" = "바다 쪽으로 조금 더 가니 집의 윤곽이 보인다.";
"chap04_arlyntrial21" = "가까이 다가가자 굴뚝에서 연기가 힘없이 피어오르는 것이 보인다.";
"chap04_arlyntrial22" = "집은 다 허물어져 거의 폐허나 다름없다.";
"chap04_arlyntrial23" = "완벽한 상태였던 적은 없지만, 그래도 어떻게든 사람이 살 수 있는 곳이었다.";
"chap04_arlyntrial24" = "문턱을 넘자 단칸방은 어둠에 잠겨 있다.";
"chap04_arlyntrial25" = "웃음이나 다툼으로 집 안을 활기차게 만들던 수많은 동생도 보이지 않는다.";
"chap04_arlyntrial26" = "완전한 침묵만이 흐른다.";
"chap04_arlyntrial27" = "눈이 어둠에 익숙해지자 누군가 있다는 것을 알아차린다.";
"chap04_arlyntrial28" = "한 남자가 침대에 앉아 두 손으로 머리를 감싸고 있다."; // Arlyn's Father : Vanik
"chap04_arlyntrial29" = "앞으로 몸을 구부린 남자의 얼굴은 길고 가느다란 머리카락에 가려져 있다.";
"chap04_arlyntrial30" = "아버지?";
"chap04_arlyntrial31" = "남자가 고개를 들고 분노가 희미하게 밴 흐린 눈으로 알린을 바라본다.";
"chap04_arlyntrial32" = "알린?";
"chap04_arlyntrial33" = "마을에서 들었다. 네가… 네가 돌아오지 않을 거라고.";

"chap04_arlyntrial34_choice01_option" = "그래도… 돌아왔어."; //Prometheus
"chap04_arlyntrial34_choice01_01" = "그래도… 돌아왔어요.";
"chap04_arlyntrial34_choice01_02" = "바니크의 얼굴에 자랑스러운 기색이 스친다.";

"chap04_arlyntrial34_choice02_option" = "아이들은 어디 있어?"; //Gaia
"chap04_arlyntrial34_choice02_01" = "아이들은 어디 있어요?";
"chap04_arlyntrial34_choice02_02" = "고통으로 일그러진 표정이 바니크의 얼굴을 스친다.";

"chap04_arlyntrial35" = "아버지도 쉽지 않았다는 건 알아요.";
"chap04_arlyntrial36" = "그웬위파르가… 병에 걸린 뒤로…";
"chap04_arlyntrial37" = "남자는 말을 잇기 싫은 듯 긴 한숨을 내쉰다.";
"chap04_arlyntrial38" = "바니크는 알린의 어머니에 관해 거의 말하지 않는다. 아내를 잃은 고통이 그만큼 컸기 때문이다.";
"chap04_arlyntrial39" = "무슨 일이 있었던 거예요? 말해 주세요.";
"chap04_arlyntrial40" = "네가 배를 타고 돌아오지 않자 어부 길드에서…";
"chap04_arlyntrial41" = "네 동생들을 뿔뿔이 흩어 배에 태웠어. 먹고 잘 곳을 얻으려면 일해야 한다면서.";
"chap04_arlyntrial42" = "형언할 수 없는 공포가 갑자기 알린을 휘감는다.";
"chap04_arlyntrial43" = "배에서 일하기에는 너무 어리잖아요!";
"chap04_arlyntrial44" = "시련의 결과가 어떻게 되든 아이들을 돌봐 주겠다고 약속했어요!";
"chap04_arlyntrial45" = "그 말을 어떻게 믿을 수 있었니?";
"chap04_arlyntrial46" = "네가 늙은 이니드를 아꼈다는 건 안다. 하지만 정말 네가 그 사람을 대신할 수 있다고 믿었니?";
"chap04_arlyntrial47" = "게다가 넌 치유사로서 재능도 전혀 없었잖아…";
"chap04_arlyntrial48" = "그럼 저더러 어떻게 하라는 거였어요?";
"chap04_arlyntrial49" = "이니드는 우리가 “외지인”의 자식이라는 사실을 신경 쓰지 않고 언제나 우리를 지켜 줬어요!";
"chap04_arlyntrial50" = "알린은 말을 잇기를 망설이다가 낮은 목소리로 덧붙인다."; 
"chap04_arlyntrial51" = "이니드는 아버지가 우리 가족에게 해 준 것보다 훨씬 더 많은 일을 해 줬어요.";
"chap04_arlyntrial52" = "어떻게 그런 말을 할 수 있니!";
"chap04_arlyntrial53" = "그웬위파르와 내가 사랑에 빠진 건 내 잘못이 아니야!";
"chap04_arlyntrial54" = "마을 사람들이 끝내 나를 받아들이지 않은 것도 내 잘못이 아니고!";
"chap04_arlyntrial55" = "우리가 결혼한다고 알렸을 때 그 바보들이 그웬위파르를 배척한 것도 내 잘못이 아니야!";
"chap04_arlyntrial56" = "물론 그웬위파르가 늙은 하웰의 아들과 결혼했다면 모두가 편했겠지.";
"chap04_arlyntrial57" = "하지만 과거는 바꿀 수 없어.";
"chap04_arlyntrial58" = "그리고 넌 기다릴 수도 있었잖아… 네가 떠난 직후에 내가 돌아왔어…";
"chap04_arlyntrial59" = "이걸 봐!";
"chap04_arlyntrial60" = "남자가 손등으로 방 건너편의 탁자를 가리킨다.";
"chap04_arlyntrial61" = "탁자에는 초라한 돈주머니가 놓여 있고, 보잘것없는 구리 동전과 은화 몇 닢이 쏟아져 있다.";

"chap04_arlyntrial62_choice01_option" = "알린이 화를 낸다."; // prometheus
"chap04_arlyntrial62_choice01_01" = "알린은 분노에 휩싸인다."; 
"chap04_arlyntrial62_choice01_02" = "알린은 작은 가죽 주머니를 움켜쥐고 아버지의 얼굴에 집어 던진다.";

"chap04_arlyntrial62_choice02_option" = "알린은 바니크를 불쌍히 여긴다."; //gaia
"chap04_arlyntrial62_choice02_01" = "알린은 깊은 경멸을 담아 아버지를 바라본다."; 
"chap04_arlyntrial62_choice02_02" = "알린은 작은 가죽 주머니를 움켜쥐고 탁자 위에 내용물을 쏟는다.";

"chap04_arlyntrial63" = "정말 이 동전 몇 닢이 무언가를 바꿀 수 있었다고 생각해요?";
"chap04_arlyntrial64" = "어머니가 돌아가신 뒤로 아버지는 늘 집에 없었잖아요!";
"chap04_arlyntrial65" = "그리고 “내가 떠난 직후”에 돌아왔다면, 왜 남아서 자식들을 돌보지 않았어요?";
"chap04_arlyntrial66" = "가족이 그렇게 견딜 수 없을 만큼 싫은 거예요?";
"chap04_arlyntrial67" = "아니야, 알린. 그게 아니라…";
"chap04_arlyntrial68" = "물론 진짜 문제와 마주하기보다는 시턴을 등에 메고 온 나라를 돌아다니는 편이 더 쉽겠죠.";
"chap04_arlyntrial69" = "하지만… 나도 어쩔 수 없어!";
"chap04_arlyntrial70" = "내가 아는 일은 음유시인 노릇뿐이야… 갑자기 어부나 목수, 아니면 뭐가 됐든 다른 사람이 될 수는 없잖아!";
"chap04_arlyntrial71" = "돌아올 때마다 번 돈을 전부 너희에게 가져다줬어…";
"chap04_arlyntrial72" = "물론 부귀영화를 누릴 만한 돈은 아니라는 걸 알아…";
"chap04_arlyntrial73" = "부귀영화요?";
"chap04_arlyntrial74" = "아이들은 굶어 죽어 가고 있었어요!";
"chap04_arlyntrial75" = "그래서 동생들이 부족한 것 없이 살 수 있게 해 주겠다는 제안을 받아들였어요!";
"chap04_arlyntrial76" = "남자가 울음을 터뜨린다.";
"chap04_arlyntrial77" = "알린은 아버지가 가엾게 느껴진다.";
"chap04_arlyntrial78" = "병으로 아내를 잃은 뒤 바니크에게는 예전 모습의 그림자만 남았다.";
"chap04_arlyntrial79" = "바니크는 두 손으로 머리를 감싼 채 “미안하다, 미안해”라는 말을 되풀이한다.";
"chap04_arlyntrial80" = "알린은 아버지를 그대로 두고 떠나기로 한다.";
"chap04_arlyntrial81" = "예언자들이 이런 광경으로 자신을 무너뜨릴 수 있다고 생각했다면 틀렸다.";
"chap04_arlyntrial82" = "알린은 조용히 작은 집을 나와 문을 닫고, 한 번도 뒤돌아보지 않은 채 절벽 길을 내려간다.";

"chap04_arlyntrial83" = "마을로 가는 길에는 아무도 없다.";
"chap04_arlyntrial84" = "겨울의 끝과 봄의 귀환을 알리는 폭풍 철이 지나면 늘 그렇다.";
"chap04_arlyntrial85" = "알린이 큰길에 도착했을 때는 밤이 거의 다 내려앉아 있다.";
"chap04_arlyntrial86" = "바다에서 불어온 차갑고 짠 바람이 안개를 걷어 내고 가랑비를 몰고 온다.";
"chap04_arlyntrial87" = "알린은 시장을 가로질러 주변의 비뚤어진 오두막들을 압도하는 유일한 2층집으로 향한다.";
"chap04_arlyntrial88" = "문을 가볍게 두드리지만 대답이 없자 더 세게 노크한다.";
"chap04_arlyntrial89" = "마침내 병색이 완연한 중년 남자가 문을 연다.";
"chap04_arlyntrial90" = "이 시간에 감히 누가 나를 방해하는 거냐?";
"chap04_arlyntrial91" = "남자는 알린을 보자 짜증에 이어 경악을 드러내더니, 이내 이를 드러내며 웃는다.";
"chap04_arlyntrial92" = "커다란 벽난로에서 타오르는 불빛을 받아 금니가 번뜩인다.";
"chap04_arlyntrial93" = "알린 바니크도티르?";
"chap04_arlyntrial94" = "참 반가운 일이군! 다시 보게 되리라고는 생각도 못 했는데.";
"chap04_arlyntrial95" = "알린은 움찔하지 않으려고 애쓰며 늙은 어부의 위압적인 시선을 마주 본다.";
"chap04_arlyntrial96" = "알린의 뒤로 호기심에 찬 사람들이 몰려든다.";
"chap04_arlyntrial97" = "마을 사람들이 소곤대는 말이 건성으로 귓가에 들어온다.";
"chap04_arlyntrial98" = "알린은 여느 때처럼 그 말을 무시한다.";
"chap04_arlyntrial99" = "이곳에서 알린은 늘 손가락질당하고 사람들이 조심스레 피하는 “외지인의 딸”이었다.";
"chap04_arlyntrial100" = "내 동생들은 어디 있어?";
"chap04_arlyntrial101" = "늙은 남자가 처음으로 시선을 피한다.";
"chap04_arlyntrial102" = "알린의 뒤에서 붉은 머리에 근육질인 거구 둘이 군중을 밀치며 나온다.";
"chap04_arlyntrial103" = "하웰 촌장님, 무슨 문제라도 있습니까?"; // Homme de main - Cormac
"chap04_arlyntrial104" = "어릿광대의 딸을 마을 밖으로 끌어낼까요?"; // Homme de main
"chap04_arlyntrial105" = "아니, 할 말이 있다면 하게 둬라.";
"chap04_arlyntrial106" = "하웰이 알린에게 다시 시선을 돌린다.";
"chap04_arlyntrial107" = "아르위드는 내 배 한 척에 타고 있다. 지난주 먼바다로 떠났으니 벨테인이 되면 돌아올 거다."; 
"chap04_arlyntrial108" = "콘웨이가 네 남동생 하나를 데려갔다. 이마에 흉한 흉터가 있는 아이 말이다.";
"chap04_arlyntrial109" = "유감이지만 그 아이는 임볼크가 조금 지난 뒤 큰 너울에 휩쓸렸다…";
"chap04_arlyntrial110" = "바다가 그 아이를 데려갔지.";
"chap04_arlyntrial111" = "알린은 가슴속에서 무언가 부서지는 것을 느낀다.";
"chap04_arlyntrial112" = "그럼… 그럼 다른 아이들은?";
"chap04_arlyntrial113" = "하웰은 연어 한 바구니 값을 흥정하듯 날카로운 눈으로 알린을 빤히 바라본다.";
"chap04_arlyntrial114" = "우리는 약속을 했지. 네가 늙은 이니드의 뒤를 잇기로 했잖아.";
"chap04_arlyntrial115" = "마을에는 아직 치유사가 없다. 겨울이 닥치자…";
"chap04_arlyntrial116" = "알린은 토할 것만 같다.";
"chap04_arlyntrial117" = "죽은 건 네 동생들뿐만이 아니다. 알프리드의 아들도 죽었어.";
"chap04_arlyntrial118" = "뭐라고?!";
"chap04_arlyntrial119" = "하지만 알프리드의 아들은 갓난아이였잖아!";
"chap04_arlyntrial120" = "소피아는 3년도 더 전에 젖을 뗐고, 내 여동생 중 가장 어렸어!";
"chap04_arlyntrial121" = "네가 자초한 일이다. 관습대로 마본 전에 돌아왔다면 네 가족을 치료할 수 있었을지도 모르지.";
"chap04_arlyntrial122" = "알린이 하웰의 얼굴에 침을 뱉는다.";
"chap04_arlyntrial123" = "하웰의 부하들이 알린의 양팔을 하나씩 붙잡는다.";

"chap04_arlyntrial124_choice01_option" = "개입한다."; //chaos
"chap04_arlyntrial124_choice01_01" = "내가 나서야 한다."; 
"chap04_arlyntrial124_choice01_02" = "알린이 나를 바라본다.";
"chap04_arlyntrial124_choice01_03" = "알린은 나를 볼 수 있다.";
"chap04_arlyntrial124_choice01_04" = "나는 앞으로 한 걸음 나서지만 알린이 곧바로 제지한다.";
"chap04_arlyntrial124_choice01_05" = "알린의 얼굴에 깨달음이 어리기 시작한다. 자신이 어디에 있고 무슨 일이 벌어지고 있는지 알아챈 듯하다.";
"chap04_arlyntrial124_choice01_06" = "안 돼!";

"chap04_arlyntrial124_choice02_option" = "나서지 않는다."; //order
"chap04_arlyntrial124_choice02_01" = "나는 개입하지 않고 일이 흘러가는 대로 두기로 한다…";
"chap04_arlyntrial124_choice02_02" = "…하지만 알린이 나를 바라본다.";
"chap04_arlyntrial124_choice02_03" = "알린은 나를 볼 수 있다.";
"chap04_arlyntrial124_choice02_04" = "알린의 얼굴에 깨달음이 어리기 시작한다. 자신이 어디에 있고 무슨 일이 벌어지고 있는지 알아챈 듯하다.";
"chap04_arlyntrial124_choice02_05" = "나는 놀라서 알린에게 손을 뻗는다.";
"chap04_arlyntrial124_choice02_06" = "안 돼!";

"chap04_arlyntrial125" = "내가 할게. 이건 내 시련이야!";
"chap04_arlyntrial126" = "마을에 깊은 정적이 내려앉는다."; 
"chap04_arlyntrial127" = "이내 촌장 집 앞마당에 모인 군중 사이로 웅성거림이 퍼진다.";
"chap04_arlyntrial128" = "갑자기 누군가 “마녀다!”라고 외친다.";
"chap04_arlyntrial129" = "다른 목소리가 이어 외친다. “태워 죽여! 죽은 자와 이야기한다!”";
"chap04_arlyntrial130" = "늙은 하웰은 헛기침하며 입을 열고 두 손을 휘저어 군중을 진정시키려 하지만 아무 소용도 없다.";
"chap04_arlyntrial131" = "군중은 광기에 빠진다.";
"chap04_arlyntrial132" = "누군가 소리친다. “저 여자는 치유사가 아니야. 사령술에 빠졌어!”";
"chap04_arlyntrial133" = "촌장의 부하 둘은 힘닿는 대로 알린을 보호하려 하지만, 마을 사람들은 야수로 돌변했다.";
"chap04_arlyntrial134" = "한 여자가 알린의 옷깃을 움켜쥔다.";
"chap04_arlyntrial135" = "한 남자는 반대편에서 알린의 가죽 겉옷을 잡아당긴다.";
"chap04_arlyntrial136" = "끈이 마침내 끊어지면서 알린은 숨이 턱 막힌다.";
"chap04_arlyntrial137" = "하지만 알린은 두렵지 않다. 오히려 그들의 증오와 어리석음이 분노에 불을 지필 뿐이다.";
"chap04_arlyntrial138" = "알린은 고함을 내지르며 온 힘을 다해 공격자들을 밀쳐 낸다.";
"chap04_arlyntrial139" = "촌장의 집에서 굉음이 나더니 불길이 늙은 남자를 집어삼키고, 참나무 바닥을 지나 위층으로 빠르게 번진다.";
"chap04_arlyntrial140" = "새까맣게 타고 피부가 물집투성이가 된 하웰이 경악한 마을 사람들 앞에서 집 밖으로 기어 나온다.";
"chap04_arlyntrial141" = "마지막 숨 넘어가는 소리가 목에서 흘러나오고, 하웰은 진흙탕에 얼굴을 처박으며 쓰러진다.";
"chap04_arlyntrial142" = "아수라장이 펼쳐진다. 어부와 빨래하는 여인들이 우왕좌왕하며 달아난다.";
"chap04_arlyntrial143" = "몇몇은 두 손으로 머리를 감싼 채 무릎을 꿇고 있다.";
"chap04_arlyntrial144" = "이웃집의 초가지붕이 거대한 불길에 휩싸인다.";
"chap04_arlyntrial145" = "반대편에서는 직조공의 집 문과 창문으로 짙은 연기가 토해지듯 뿜어져 나온다.";
"chap04_arlyntrial146" = "알린이 나를 돌아본다.";
"chap04_arlyntrial147" = "가자. 섬으로 돌아갈 시간이야."; //Arlyn
"chap04_arlyntrial148" = "갑자기 우리는 동굴 안에 서 있다.";
"chap04_arlyntrial149" = "차갑고 맑은 동굴 공기에 유황 냄새가 섞여 있다.";
"chap04_arlyntrial150" = "알린은 내게서 시선을 떼지 않는다.";

"chap04_arlyntrial151" = "내가 보여?";
"chap04_arlyntrial152" = "응. 해변부터 계속 우리를 따라왔지?";
"chap04_arlyntrial153" = "나는 고개를 끄덕인다.";
"chap04_arlyntrial154" = "알린의 표정이 굳어진다.";
"chap04_arlyntrial155" = "프레이야, 던컨, 코너도… 위험한 거야?";
"chap04_arlyntrial156" = "다른 사람들도 각자의 시련을 겪고 있을 게 분명하다는 걸 깨닫는다.";
"chap04_arlyntrial157" = "그래, 그들을 도와야 해!";
"chap04_arlyntrial158" = "나도 같이 갈게!";
"chap04_arlyntrial159" = "안 돼! 넌 도움이 될 수 없어.";
"chap04_arlyntrial160" = "동굴 반대편 출구에서 기다려.";
"chap04_arlyntrial161" = "나는 몸을 돌려 동굴 입구를 향해 달린다.";
"chap04_arlyntrial162" = "다른 사람들에게 너무 늦지 않았기를 바란다.";
"chap04_arlyntrial163" = "출구에 가까워질수록 인간의 세계에 나를 붙잡아 두던 힘이 다시 빠져나가는 것을 느낀다.";
"chap04_arlyntrial164" = "소나무 사이를 달리며 내가 다시 보이지 않게 되었다는 걸 안다.";
"chap04_arlyntrial165" = "숲을 빠르게 헤치며 프레이야의 흔적을 찾지만 소용이 없다.";
"chap04_arlyntrial166" = "프레이야의 운명은 이미 정해졌다…";
"chap04_arlyntrial167" = "야영지로 돌아가야 한다. 너무 지체하면 던컨과 코너에게도 늦고 말 것이다.";


/*** Chapter 4 — Camp / POV: Rowan / Duncan-Connor ***/

"chap04_camp01" = "나는 최대한 빠르게 숲을 가로지른다.";
"chap04_camp02" = "폭포에 도착해 던컨과 코너를 발견하자 안도감이 든다.";
"chap04_camp03" = "코너는 딴생각에 잠긴 채 막대기로 모닥불을 뒤적이고 있고, 던컨은 옷을 입는 중이다.";
"chap04_camp04" = "내가 없는 동안 폭포 아래의 웅덩이에서 몸을 씻은 모양이다.";
"chap04_camp06" = "두 사람 주변에 불안감이 감돈다.";
"chap04_camp07" = "던컨은 알린이나 프레이야의 흔적이 보이기를 바라는 듯 숲을 샅샅이 살핀다.";
"chap04_camp08" = "코너가 던컨을 돌아본다.";
"chap04_camp09" = "아직도 아무것도 없어?";
"chap04_camp10" = "아니…";
"chap04_camp11" = "너무 오래 걸려. 내가 가서 찾아볼게."; //Duncan
"chap04_camp12" = "음… 정말 흩어지는 게 좋은 생각일까?";
"chap04_camp13" = "두 사람에게 경고하고 싶다…";
"chap04_camp14" = "던컨의 정신에 이어 코너의 정신에도 파고들려 하지만 소용이 없다.";
"chap04_camp15" = "던컨이 시선을 내린다.";
"chap04_camp16" = "여기서 아무것도 하지 않고 있을 수는 없어.";
"chap04_camp17" = "그렇다면 나도 같이 갈게.";
"chap04_camp18" = "안 돼. 혹시 모르니까 한 사람은 여기서 기다려야 해…";
"chap04_camp19" = "걱정하지 마. 조심할게.";
"chap04_camp20" = "코너가 씁쓸한 듯 희미하게 웃는다.";
"chap04_camp21" = "마치 앞으로 무슨 일이 닥칠지 아는 것처럼.";
"chap04_camp22" = "던컨이 서둘러 나무 사이로 사라진다.";

