"chap07_freya_thesummit49" = "제니버가 슬픈 눈으로 나를 바라본다.";
"chap07_freya_thesummit50" = "로완, 로완…";
"chap07_freya_thesummit51" = "예언자들은 네 행동 때문에 한 남자의 아들이 죽었다는 사실에는 정말 관심이 없어.";
"chap07_freya_thesummit52" = "너희 운명의 실은 원래 그렇게 짜여 있었으니까.";
"chap07_freya_thesummit53" = "제니버가 맨발의 발끝으로 크롬렉의 풀밭을 미끄러지듯 지나, 고양이처럼 우아하게 내게 다가온다…";
"chap07_freya_thesummit54" = "…하지만 프레이야가 앞을 가로막는다.";
"chap07_freya_thesummit55" = "제니버…"; //Freya
"chap07_freya_thesummit56" = "로완은 이미 죗값을 충분히 치르지 않았어?";
"chap07_freya_thesummit57" = "프레이야가 힘찬 명령조로 덧붙인다.";
"chap07_freya_thesummit58" = "로완이 섬을 떠나게 해 줘.";
"chap07_freya_thesummit59" = "잠시 망설임이 흐른 뒤, 예언자들은 가면을 다시 쓰고 프레이야에게서 물러난다.";
"chap07_freya_thesummit60" = "무슨 일이 일어날지 안다.";
"chap07_freya_thesummit61" = "이미 일어난 일이니까.";
"chap07_freya_thesummit62" = "예언자들은 크롬렉 가장자리에 원을 이루고 지팡이로 땅을 두드린다.";
"chap07_freya_thesummit63" = "수정처럼 맑은 웅얼거림이 울려 퍼지고, 일정한 지팡이 소리가 대지에 메아리치며 장단을 넣는다.";
"chap07_freya_thesummit64" = "배 속에 둔탁한 통증 덩어리가 퍼지는 게 느껴진다.";
"chap07_freya_thesummit65" = "나도 모르게 고통스러운 비명이 터져 나온다.";
"chap07_freya_thesummit66" = "프레이야가 나를 돌아본다.";
"chap07_freya_thesummit67" = "괜찮다는 뜻으로 손짓한다.";
"chap07_freya_thesummit68" = "제니버, 무슨 일이야?"; //Freya
"chap07_freya_thesummit69" = "프레이야는 넋이 나가 믿을 수 없다는 표정이다.";
"chap07_freya_thesummit70" = "의식을 방해하려 하지 마, 프레이야.";
"chap07_freya_thesummit71" = "네가 로완을 위해 할 수 있는 일은 없어. 미안해.";
"chap07_freya_thesummit72" = "하지만… 안 돼!";
"chap07_freya_thesummit73" = "배의 고통이 거의 견딜 수 없을 만큼 심해진다.";
"chap07_freya_thesummit74" = "프레이야는 두 손을 자유롭게 하려고 열매를 땅에 떨어뜨리고 창을 잡아 경계 태세를 갖춘다.";
"chap07_freya_thesummit75" = "제니버는 프레이야에게서 눈을 떼지 않은 채 드레스 주름에 숨겨 둔 긴 단검을 꺼낸다.";
"chap07_freya_thesummit76" = "프레이야가 창을 고쳐 잡고 예언자 하나에게 던질 준비를 한다.";
"chap07_freya_thesummit77" = "이건 부당해!"; //Freya
"chap07_freya_thesummit78" = "나… 난 네가 그렇게 하게 둘 수 없어.";
"chap07_freya_thesummit79" = "제니버는 프레이야가 경계를 늦춘 틈을 타 등 뒤로 미끄러져 들어간다.";
"chap07_freya_thesummit80" = "한 팔로 프레이야의 창을 막고…";
"chap07_freya_thesummit81" = "…다른 팔로는 프레이야의 배에 단검을 꽂는다.";
"chap07_freya_thesummit82" = "프레이야가 무릎을 꿇는다.";
"chap07_freya_thesummit83" = "왜?"; //Jennyver
"chap07_freya_thesummit84" = "넌 시련을 통과했잖아!";
"chap07_freya_thesummit85" = "거의 알지도 못하는 이 여자 때문에 왜 계속 모든 걸 망치는 거야?";
"chap07_freya_thesummit86" = "프레이야가 제니버를 올려다보며 미소 짓는다.";
"chap07_freya_thesummit87" = "예언자들은 내 언니를 앗아갔어… 내 여행 동료들도 앗아갔고…"; //Freya
"chap07_freya_thesummit88" = "아무것도 할 수 없었어…";
"chap07_freya_thesummit89" = "이번에는 무언가 할 수 있어.";

"chap07_freya_thesummit90" = "남은 힘을 모두 끌어모아 나무를 향해 기어간다.";
"chap07_freya_thesummit91" = "예언자들은 나를 늦출 수는 있어도 막을 수는 없다.";
"chap07_freya_thesummit92" = "내가 해야 할 일이 뭔지 알아.";
"chap07_freya_thesummit93" = "프레이야가 이런 식으로 자신을 희생하게 둘 수는 없다.";
"chap07_freya_thesummit94" = "제니버가 이를 알아차리고 내 길을 막으려 한 걸음 다가온다.";
"chap07_freya_thesummit95" = "프레이야가 마지막 힘을 다해 제니버에게 달려들어 붙잡고 함께 크롬렉 바닥으로 나뒹군다.";
"chap07_freya_thesummit96" = "두 걸음만 더 가면 불꽃나무다.";
"chap07_freya_thesummit97" = "나무줄기의 옹이 안으로 손을 찔러 넣는다.";
"chap07_freya_thesummit98" = "나무껍질 안은 구역질 날 만큼 끈적하고 따뜻하다. 나무의 형상 안에 어떤 짐승 같은 생명이 숨겨져 있는 듯하다.";
"chap07_freya_thesummit99" = "고동치는 나무의 심장을 뜯어낸다.";
"chap07_freya_thesummit100" = "지체할 여유가 없다.";
"chap07_freya_thesummit101" = "프레이야와 제니버가 몇 걸음 떨어진 곳에서 바닥을 뒹굴며 싸운다.";
"chap07_freya_thesummit102" = "부상을 입었는데도 프레이야가 공격자를 제압한 듯하다.";
"chap07_freya_thesummit103" = "프레이야가 결연한 눈빛을 보내고, 그 눈빛에 힘을 얻어 계속 나아간다.";
"chap07_freya_thesummit104" = "또 한 번, 다시 시작할 힘을.";
"chap07_freya_thesummit105" = "예언자들의 노래가 공중으로 솟아 대지에 울려 퍼지고, 원소들이 그 부름에 응답하는 듯하다.";
"chap07_freya_thesummit106" = "흑단빛 심장을 깨문다.";
"chap07_freya_thesummit107" = "번쩍이는 빛에 눈이 멀 듯하다.";
"chap07_freya_thesummit108" = "빙하처럼 차가운 산 공기.";
"chap07_freya_thesummit109" = "주홍빛 잎이 금빛 비처럼 우리 주위로 떨어진다.";
"chap07_freya_thesummit110" = "두개골에서 뿔이 다시 자라나는 게 느껴진다.";
"chap07_freya_thesummit111" = "그리고 공허.";
"chap07_freya_thesummit112" = "나는 시간의 여명으로 내던져진다.";
"chap07_freya_thesummit113" = "무엇이 기다리는지 안다.";
"chap07_freya_thesummit114" = "인간이 아직 두 발로 걷지도 못하던 시대, 섬의 고독 속에서 견뎌야 할 끝없는 시간.";
"chap07_freya_thesummit115" = "건설자들의 시대.";
"chap07_freya_thesummit116" = "그들을 섬에서 지워 버린 마법의 대재앙.";
"chap07_freya_thesummit117" = "마본과 사윈의 폭풍이 몰고 온 바람과 눈, 억수 같은 비에 휩쓸리는 선돌들.";
"chap07_freya_thesummit118" = "생명나무를 지키기 위해 영적 세계에서 내려오는 수호자 예언자들.";
"chap07_freya_thesummit119" = "프레이야에 대한 기억에 매달린다.";
"chap07_freya_thesummit120" = "잊어서는 안 된다. 이번만큼은.";
"chap07_freya_thesummit121" = "프레이야가 거듭 자신을 희생하게 둘 수는 없다.";
"chap07_freya_thesummit122" = "이 순환의 고리를 끊어야 한다.";
"chap07_freya_thesummit123" = "황야가 보랏빛 꽃으로 뒤덮이는 모습을 보았다.";
"chap07_freya_thesummit124" = "리타가 되면 풀은 누렇게 물들었다.";
"chap07_freya_thesummit125" = "백 년 묵은 참나무의 잎이 붉어지고 떨어져, 이끼 낀 숲 바닥을 주황빛 갈색 부엽토로 덮었다.";
"chap07_freya_thesummit126" = "율의 첫눈…";
"chap07_freya_thesummit127" = "살아 있는 영혼은 하나도 없었다.";
"chap07_freya_thesummit128" = "나는 그들이 돌아오기를 끈기 있게 기다렸다.";
"chap07_freya_thesummit129" = "그리고 그들이 왔다…";
"chap07_freya_thesummit130" = "…하지만 이번에는 맞이할 준비가 되어 있었다.";
"chap07_freya_thesummit131" = "이번에는 그들을 잊지 않았다.";
//-> Stage: "chap07_freya_timeknot"


/*** Chapter 7 — Freya — Time Knot ***/
"chap07_freya_timeknot01" = "그들은 해변에 상륙해 황야로 들어갔다.";
"chap07_freya_timeknot02" = "프레이야는 불안한 표정으로 대열 뒤를 따른다.";
"chap07_freya_timeknot03" = "몇 번이나 프레이야가 마치 나를 보는 듯 내 쪽을 바라보는 기분이 든다.";
"chap07_freya_timeknot04" = "일행이 크롬렉에 도착했을 때는 해가 거의 져 있다.";
"chap07_freya_timeknot05" = "그들은 야영하기로 한다.";
"chap07_freya_timeknot06" = "이번에는 프레이야가 불안한 표정으로 모닥불을 응시하며 잠들지 않는다.";
"chap07_freya_timeknot07" = "동료들이 잠든 것을 확인하자 소리 없이 일어나 내게 다가온다.";
"chap07_freya_timeknot08" = "호기심 어린 눈으로 나를 바라본다.";
"chap07_freya_timeknot09" = "로완…";
"chap07_freya_timeknot10" = "기억나?";
"chap07_freya_timeknot11" = "프레이야는 잠시 생각하더니 거의 알아차릴 수 없을 만큼 살짝 고개를 끄덕인다.";
"chap07_freya_timeknot12" = "모르겠어. 조금은?";
"chap07_freya_timeknot13" = "오늘 아침 해변에 상륙한 뒤로 계속 기시감이 들었어.";
"chap07_freya_timeknot14" = "프레이야가 맑고 날카로운 눈으로 나를 바라본다.";
"chap07_freya_timeknot15" = "하지만 넌 기억나.";
"chap07_freya_timeknot16" = "그건 확실해.";
"chap07_freya_timeknot17" = "야영지와 잠든 여행 동료들을 힐끗 바라본다.";
"chap07_freya_timeknot18" = "왜 나만 널 볼 수 있는 거지?";
"chap07_freya_timeknot19" = "잠시 생각한다.";
"chap07_freya_timeknot20" = "지난 순환에서 우리는 함께 정상까지 올랐어.";
"chap07_freya_timeknot21" = "그 일로 우리 둘 사이에 연결이 생긴 것 같아.";
"chap07_freya_timeknot22" = "수… 순환?";
"chap07_freya_timeknot23" = "여기서 일어나는 모든 일이 이미 일어났다는 거야?";
"chap07_freya_timeknot24" = "정상에 도착할 때마다 예언자들은 우리를 과거로 돌려보내…";

"chap07_freya_timeknot25_choice01_option" = "…전부 나 때문이야."; //-> Rowan dies
"chap07_freya_timeknot25_choice01_01" = "…전부 내 잘못이야.";
"chap07_freya_timeknot25_choice01_02" = "눈을 내리깐다."; 
"chap07_freya_timeknot25_choice01_03" = "난 이 섬에 있어서는 안 돼.";
"chap07_freya_timeknot25_choice01_04" = "예언자들이 나를 보내 줄 생각이 없다는 것만 알아.";
"chap07_freya_timeknot25_choice01_05" = "그리고 나는… 지금까지 자유를 포기할 준비가 되지 않았어.";
"chap07_freya_timeknot25_choice01_06" = "…내 미래도.";
"chap07_freya_timeknot25_choice01_07" = "예언자들은 공정하잖아…"; //Freya
"chap07_freya_timeknot25_choice01_08" = "분명 그럴 만한 이유가 있는 거겠지?";
"chap07_freya_timeknot25_choice01_09" = "프레이야가 나를 조금 불신하는 게 느껴진다.";
"chap07_freya_timeknot25_choice01_10" = "예언자들이 무엇을 원하는지, 과연 공정하고 사심 없는지 모르겠어…";
"chap07_freya_timeknot25_choice01_11" = "…하지만 상황을 바꾸려면 내가 무엇을 해야 하는지는 알아.";
"chap07_freya_timeknot25_choice01_12" = "내가 아는 유일한 탈출구를 프레이야에게 설명할 말을 찾으며 잠시 멈춘다.";
"chap07_freya_timeknot25_choice01_13" = "순환을 끊을 유일한 방법.";
"chap07_freya_timeknot25_choice01_14" = "등 뒤 크롬렉에서 비친 빛이 우리 말을 끊는다.";
"chap07_freya_timeknot25_choice01_15" = "프레이야… 숨어야 해…";
"chap07_freya_timeknot25_choice01_16" = "예언자들이…";
"chap07_freya_timeknot25_choice01_17" = "알겠어.";
"chap07_freya_timeknot25_choice01_18" = "해변으로 돌아간다.";
//-> Stage : Rowan dies

"chap07_freya_timeknot25_choice02_option" = "…전부 제니버 때문이야."; 
"chap07_freya_timeknot25_choice02_01" = "…전부 제니버 때문이야.";
"chap07_freya_timeknot25_choice02_02" = "프레이야는 충격을 받는다.";
"chap07_freya_timeknot25_choice02_03" = "제니버?";
"chap07_freya_timeknot25_choice02_04" = "하지만 제니버는 너무… 순해 보이는데.";
"chap07_freya_timeknot25_choice02_05" = "지금은 그래."; //Rowan
"chap07_freya_timeknot25_choice02_06" = "예언자들이 제니버를 우리와 맞서게 할 거야.";
"chap07_freya_timeknot25_choice02_07" = "프레이야는 이전 순환에서 무슨 일이 있었는지 기억해 내려는 듯 생각에 잠겨 눈을 내리깐다.";
"chap07_freya_timeknot25_choice02_08" = "오늘 밤 예언자들이 제니버를 데려갈 거야.";
"chap07_freya_timeknot25_choice02_09" = "등 뒤 크롬렉에서 비친 빛이 우리 말을 끊는다.";
"chap07_freya_timeknot25_choice02_10" = "프레이야… 숨어야 해…";
"chap07_freya_timeknot25_choice02_11" = "예언자들이…";
"chap07_freya_timeknot25_choice02_12" = "알겠어.";
"chap07_freya_timeknot25_choice02_13" = "해변으로 돌아간다.";
